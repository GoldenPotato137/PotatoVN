<Page
    x:Class="GalgameManager.Views.PluginStorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:GalgameManager.Models"
    xmlns:converter="using:GalgameManager.Helpers.Converter"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:viewModels="using:GalgameManager.ViewModels"
    x:Name="Page"
    mc:Ignorable="d">

    <Page.Resources>
        <converter:DateTimeToStringConverter x:Key="DateTimeToStringConverter" />
        <converter:DownloadCountToStringConverter x:Key="DownloadCountToStringConverter" />
        <converter:ImagePathConverter x:Key="ImagePathConverter" />
        <converter:StorePluginStatusToOpacityConverter x:Key="StorePluginStatusToOpacityConverter" />
        <converter:StorePluginStatusToTextConverter x:Key="StorePluginStatusToTextConverter" />
        <converter:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid>
        <NavigationView IsBackButtonVisible="Collapsed" IsBackEnabled="False" OpenPaneLength="150"
                        MenuItemsSource="{x:Bind ViewModel.PluginTypes}"
                        SelectedItem="{x:Bind ViewModel.SelectedPluginType, Mode=TwoWay}"
                        IsSettingsVisible="False"
                        >
            <NavigationView.MenuItemTemplate>
                <DataTemplate x:DataType="viewModels:PluginTypeViewModel">
                    <NavigationViewItem Content="{x:Bind Title}"
                                        Icon="{x:Bind Icon}"/>
                </DataTemplate>
            </NavigationView.MenuItemTemplate>

            <Grid RowDefinitions="Auto,*">
                <!-- 安装状态过滤-->
                <!-- 选项由ViewModel.StatusFilters在代码后置里生成，见PluginStorePage.xaml.cs -->
                <controls:SelectorBar x:Name="StatusFilterBar" Grid.Row="0"
                                      HorizontalAlignment="Left" Margin="20,0,20,0"
                                      SelectionChanged="StatusFilterBar_SelectionChanged"/>

                <ScrollViewer Grid.Row="1">
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Plugins}" Margin="20,12,20,20">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:StorePlugin">
                                <Button Style="{ThemeResource TransparentButtonWithHover}"
                                        DataContext="{x:Bind}"
                                        Command="{Binding ElementName=Page, Path=ViewModel.ItemClickCommand}"
                                        CommandParameter="{x:Bind}">
                                    <Grid Width="300" Height="120" ColumnSpacing="20" Margin="10 10" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Logo -->
                                        <Grid Grid.Column="0" CornerRadius="10" Width="65" Height="65" VerticalAlignment="Center">
                                            <Image Source="{x:Bind Logo, Mode=OneWay, Converter={StaticResource ImagePathConverter}}"
                                                   Stretch="UniformToFill">
                                            </Image>
                                        </Grid>

                                        <Grid Grid.Column="1" Margin="0 0 10 0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Title -->
                                            <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                                       Style="{ThemeResource SubtitleTextBlockStyle}"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <!-- Description -->
                                            <TextBlock Grid.Row="1" Text="{x:Bind DescriptionShort, Mode=OneWay}"
                                                       Style="{ThemeResource BodyTextBlockStyle}"
                                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                       Margin="0,4,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                            <!-- 日期与下载数优先完整显示，空间不够时（如英文/日文的较长状态文本）由状态标签截断 -->
                                            <Grid Grid.Row="2" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                                    <!-- Release Date -->
                                                    <TextBlock Text="{x:Bind ReleaseDate, Mode=OneWay, Converter={StaticResource DateTimeToStringConverter}}"
                                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

                                                    <!-- Downloads: 所有版本下载次数之和 -->
                                                    <StackPanel x:Uid="PluginStorePage_Downloads" Orientation="Horizontal" Spacing="4"
                                                                Background="Transparent">
                                                        <FontIcon Glyph="&#xE896;" FontSize="12" VerticalAlignment="Center"
                                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                        <TextBlock Text="{x:Bind Downloads, Converter={StaticResource DownloadCountToStringConverter}}"
                                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Status -->
                                                <Grid Grid.Column="1" HorizontalAlignment="Right"
                                                      Opacity="{x:Bind Status, Mode=OneWay, Converter={StaticResource StorePluginStatusToOpacityConverter}}">
                                                    <Border Background="{ThemeResource SystemControlBackgroundAccentBrush}" CornerRadius="4" Padding="6 2">
                                                        <TextBlock Text="{x:Bind Status, Mode=OneWay, Converter={StaticResource StorePluginStatusToTextConverter}}"
                                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                                   Foreground="White"/>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="300" ItemsStretch="Fill"
                                               MinRowSpacing="10" MinColumnSpacing="10"/>
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </ScrollViewer>

                <!-- 过滤结果为空时的提示，顺手给一个把过滤条件恢复成默认值的入口 -->
                <StackPanel Grid.Row="1" Spacing="8" MaxWidth="320"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.ShowEmptyHint, Mode=OneWay,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE71C;" FontSize="32"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <TextBlock x:Uid="PluginStorePage_NoPluginMatched"
                               Style="{ThemeResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                    <HyperlinkButton x:Uid="PluginStorePage_ResetFilter" HorizontalAlignment="Center"
                                     Command="{x:Bind ViewModel.ResetFilterCommand}"/>
                </StackPanel>
            </Grid>
        </NavigationView>
    </Grid>
</Page>
