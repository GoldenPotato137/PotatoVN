<Page
    x:Class="GalgameManager.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sources="using:GalgameManager.Models.Sources"
    xmlns:control="using:GalgameManager.Views.Control"
    xmlns:prefab="using:GalgameManager.Views.Prefab"
    xmlns:models="using:GalgameManager.Models"
    xmlns:behaviors="using:GalgameManager.Behaviors"
    xmlns:converter="using:GalgameManager.Helpers.Converter"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    mc:Ignorable="d"
    x:Name="Page"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <converter:EnumEqualsConverter x:Key="EnumEqualsConverter" />
        <!-- 库卡片悬停背景（与 TransparentButtonWithHover 一致） -->
        <SolidColorBrush x:Key="SourceHoverBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.12" />
        <!-- 游戏库的右键菜单 -->
        <MenuFlyout Placement="Right" x:Key="FolderFlyout" Opening="{x:Bind ViewModel.FolderFlyout_Opening}">
            <!-- 编辑游戏库 -->
            <MenuFlyoutItem Icon="Edit" x:Uid="LibraryPage_EditFolder"
                            Command="{x:Bind ViewModel.EditLibraryCommand}" CommandParameter="{x:Bind ViewModel.CurrentContextSource, Mode=OneWay}"/>
            <!-- 在资源管理器中打开 -->
            <MenuFlyoutItem Icon="OpenLocal" x:Uid="LibraryPage_OpenFolderInExplorer"
                            IsEnabled="{x:Bind ViewModel.CurrentContextSource.IsDelectable, Mode=OneWay}"
                            Command="{x:Bind ViewModel.OpenFolderInExplorerCommand}" CommandParameter="{x:Bind ViewModel.CurrentContextSource, Mode=OneWay}"/>
            <!-- 删除游戏库 -->
            <MenuFlyoutItem Icon="Delete" x:Uid="LibraryPage_DeleteFolder"
                            IsEnabled="{x:Bind ViewModel.CurrentContextSource.IsDelectable, Mode=OneWay}"
                            Command="{x:Bind ViewModel.DeleteFolderCommand}" CommandParameter="{x:Bind ViewModel.CurrentContextSource, Mode=OneWay}"/>
        </MenuFlyout>

        <!-- 页面空白处的右键菜单 -->
        <MenuFlyout Placement="Right" x:Key="PageFlyout">
            <MenuFlyoutItem Icon="Edit" x:Uid="LibraryPage_EditCurrentFolder"
                           Command="{x:Bind ViewModel.EditCurrentFolderCommand}"
                           IsEnabled="{x:Bind ViewModel.IsBackEnabled, Mode=OneWay}"/>
        </MenuFlyout>

        <!-- 游戏的右键菜单 -->
        <MenuFlyout Placement="Right" x:Key="GameFlyout" Opening="{x:Bind ViewModel.GalFlyout_Opening}">
            <!-- 游玩状态管理 -->
            <MenuFlyoutSubItem x:Uid="LibraryPage_PlayStatusSubMenu">
                <MenuFlyoutSubItem.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons"
                            Glyph="&#xE74C;"/>
                </MenuFlyoutSubItem.Icon>
                <RadioMenuFlyoutItem x:Uid="LibraryPage_PlayStatusPlaying"
                                     Command="{x:Bind ViewModel.GalFlyOutChangePlayStatusCommand}"
                                     CommandParameter="Playing"
                                     IsChecked="{x:Bind ViewModel.IsCurrentPlayType(ViewModel.CurrentContextGame, 'Playing'), Mode=OneWay}"
                                     GroupName="PlayStatus"/>
                <RadioMenuFlyoutItem x:Uid="LibraryPage_PlayStatusPlayed"
                                     Command="{x:Bind ViewModel.GalFlyOutChangePlayStatusCommand}"
                                     CommandParameter="Played"
                                     IsChecked="{x:Bind ViewModel.IsCurrentPlayType(ViewModel.CurrentContextGame, 'Played'), Mode=OneWay}"
                                     GroupName="PlayStatus"/>
                <RadioMenuFlyoutItem x:Uid="LibraryPage_PlayStatusOnHold"
                                     Command="{x:Bind ViewModel.GalFlyOutChangePlayStatusCommand}"
                                     CommandParameter="Shelved"
                                     IsChecked="{x:Bind ViewModel.IsCurrentPlayType(ViewModel.CurrentContextGame, 'Shelved'), Mode=OneWay}"
                                     GroupName="PlayStatus"/>
                <RadioMenuFlyoutItem x:Uid="LibraryPage_PlayStatusAbandoned"
                                     Command="{x:Bind ViewModel.GalFlyOutChangePlayStatusCommand}"
                                     CommandParameter="Abandoned"
                                     IsChecked="{x:Bind ViewModel.IsCurrentPlayType(ViewModel.CurrentContextGame, 'Abandoned'), Mode=OneWay}"
                                     GroupName="PlayStatus"/>
                <RadioMenuFlyoutItem x:Uid="LibraryPage_PlayStatusWantToPlay"
                                     Command="{x:Bind ViewModel.GalFlyOutChangePlayStatusCommand}"
                                     CommandParameter="WantToPlay"
                                     IsChecked="{x:Bind ViewModel.IsCurrentPlayType(ViewModel.CurrentContextGame, 'WantToPlay'), Mode=OneWay}"
                                     GroupName="PlayStatus"/>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="LibraryPage_PlayStatusMoreSettings"
                     Command="{x:Bind ViewModel.ShowChangePlayStatusDialogCommand}" CommandParameter="{Binding}" />
            </MenuFlyoutSubItem>
            <!-- 编辑游戏信息 -->
            <MenuFlyoutItem Icon="Edit" x:Uid="LibraryPage_EditGameInfo"
                           Command="{x:Bind ViewModel.GalFlyOutEditCommand}"
                           CommandParameter="{Binding}"/>
            <!-- 下载游戏信息 -->
            <MenuFlyoutItem Icon="Download" x:Uid="LibraryPage_DownloadGameInfo"
                           Command="{x:Bind ViewModel.GalFlyOutGetInfoFromRssCommand}"
                           CommandParameter="{Binding}"/>
            <!-- 在文件管理器中打开 -->
            <MenuFlyoutSubItem Icon="OpenLocal" x:Uid="LibraryPage_OpenGameInExplorer"
                               Tag="InstallationFolders"/>
            <!-- 删除游戏 -->
            <MenuFlyoutItem Icon="Delete" x:Uid="LibraryPage_RemoveGame"
                           Command="{x:Bind ViewModel.GalFlyOutDeleteCommand}"
                           CommandParameter="{Binding}"/>
        </MenuFlyout>
    </Page.Resources>


    <Grid Margin="0 0 0 20" ContextFlyout="{StaticResource PageFlyout}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0" Background="Transparent" IsOpen="False" DefaultLabelPosition="Right"
                    Margin="{StaticResource CommandBarMargin}">
            <!-- 返回 -->
            <AppBarButton Icon="Back" x:Uid="LibraryPage_Back"
                          Command="{x:Bind ViewModel.BackCommand}"
                          IsEnabled="{x:Bind ViewModel.IsBackEnabled, Mode=OneWay}">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="Left"/>
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <!-- 新增游戏库 -->
            <AppBarButton Icon="Add" x:Uid="LibraryPage_AddGalgameFolder"
                          Command="{x:Bind ViewModel.AddLibraryCommand}">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="N"/>
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <!-- 扫描所有库 -->
            <AppBarButton Icon="Refresh" x:Uid="LibraryPage_ScanAll"
                          Command="{x:Bind ViewModel.ScanAllCommand}">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="R"/>
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <!-- 编辑当前库 -->
            <AppBarButton Icon="Edit"
                    x:Uid="LibraryPage_EditCurrentFolder_AppBarButton"
                          Command="{x:Bind ViewModel.EditCurrentFolderCommand}"
                          IsEnabled="{x:Bind ViewModel.IsBackEnabled, Mode=OneWay}">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control"
                            Key="E"/>
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <!-- 搜索 -->
            <AppBarButton Icon="Find" Label="{x:Bind ViewModel.SearchTitle, Mode=OneWay}">
                <AppBarButton.Flyout>
                    <Flyout Placement="Bottom">
                        <control:SearchAutoSuggestBox SearchCommand="{x:Bind ViewModel.SearchCommand}"
                            SearchKey="{x:Bind ViewModel.SearchKey, Mode=TwoWay}"/>
                    </Flyout>
                </AppBarButton.Flyout>
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="F" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>

            <!-- 添加排序按钮 -->
            <AppBarButton Icon="Sort" x:Uid="LibraryPage_Sort">
                <AppBarButton.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <!-- 游戏排序 -->
                        <MenuFlyoutSubItem x:Uid="LibraryPage_SortGameSubMenu" >
                            <RadioMenuFlyoutItem x:Uid="LibraryPage_SortByName"
                                               Command="{x:Bind ViewModel.SortCommand}"
                                               CommandParameter="{x:Bind ViewModel.NameSortKey}"
                                               GroupName="GameSorting"
                                               IsChecked="{x:Bind ViewModel.CurrentSortKey, Mode=OneWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Name}"/>
                            <RadioMenuFlyoutItem x:Uid="LibraryPage_SortByLastPlay"
                                               Command="{x:Bind ViewModel.SortCommand}"
                                               CommandParameter="{x:Bind ViewModel.LastPlaySortKey}"
                                               GroupName="GameSorting"
                                               IsChecked="{x:Bind ViewModel.CurrentSortKey, Mode=OneWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=LastPlay}"/>
                            <RadioMenuFlyoutItem x:Uid="LibraryPage_SortByDeveloper"
                                               Command="{x:Bind ViewModel.SortCommand}"
                                               CommandParameter="{x:Bind ViewModel.DeveloperSortKey}"
                                               GroupName="GameSorting"
                                               IsChecked="{x:Bind ViewModel.CurrentSortKey, Mode=OneWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Developer}"/>
                            <RadioMenuFlyoutItem x:Uid="LibraryPage_SortByRating"
                                               Command="{x:Bind ViewModel.SortCommand}"
                                               CommandParameter="{x:Bind ViewModel.RatingSortKey}"
                                               GroupName="GameSorting"
                                               IsChecked="{x:Bind ViewModel.CurrentSortKey, Mode=OneWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Rating}"/>
                            <RadioMenuFlyoutItem x:Uid="LibraryPage_SortByReleaseDate"
                                               Command="{x:Bind ViewModel.SortCommand}"
                                               CommandParameter="{x:Bind ViewModel.ReleaseDateSortKey}"
                                               GroupName="GameSorting"
                                               IsChecked="{x:Bind ViewModel.CurrentSortKey, Mode=OneWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=ReleaseDate}"/>
                            <RadioMenuFlyoutItem x:Uid="LibraryPage_SortByAddTime"
                                               Command="{x:Bind ViewModel.SortCommand}"
                                               CommandParameter="{x:Bind ViewModel.AddTimeSortKey}"
                                               GroupName="GameSorting"
                                               IsChecked="{x:Bind ViewModel.CurrentSortKey, Mode=OneWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=AddTime}"/>
                            <RadioMenuFlyoutItem x:Uid="LibraryPage_SortByPath"
                                                  Command="{x:Bind ViewModel.SortCommand}"
                                                  CommandParameter="{x:Bind ViewModel.PathSortKey}"
                                                  GroupName="GameSorting"
                                                  IsChecked="{x:Bind ViewModel.CurrentSortKey, Mode=OneWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Path}"/>
                            <MenuFlyoutSeparator/>
                            <ToggleMenuFlyoutItem x:Uid="LibraryPage_GameSortDescending"
                                                 IsChecked="{x:Bind ViewModel.GameSortDescending, Mode=TwoWay}"
                                                 Command="{x:Bind ViewModel.ApplySortingCommand}"/>
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSeparator/>
                        <!-- 库排序 -->
                        <MenuFlyoutSubItem x:Uid="LibraryPage_SortFolderSubMenu" >
                            <RadioMenuFlyoutItem x:Uid="LibraryPage_FolderSortByCustom"
                                               Command="{x:Bind ViewModel.SortLibraryCommand}"
                                               CommandParameter="{x:Bind ViewModel.LibraryCustomSortKey}"
                                               GroupName="FolderSorting"
                                               IsChecked="{x:Bind ViewModel.CurrentFolderSortKey, Mode=OneWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Custom}"/>
                            <RadioMenuFlyoutItem x:Uid="LibraryPage_FolderSortByName"
                                               Command="{x:Bind ViewModel.SortLibraryCommand}"
                                               CommandParameter="{x:Bind ViewModel.LibraryNameSortKey}"
                                               GroupName="FolderSorting"
                                               IsChecked="{x:Bind ViewModel.CurrentFolderSortKey, Mode=OneWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Name}"/>
                            <RadioMenuFlyoutItem x:Uid="LibraryPage_FolderSortByLastPlayed"
                                               Command="{x:Bind ViewModel.SortLibraryCommand}"
                                               CommandParameter="{x:Bind ViewModel.LibraryLastPlayedSortKey}"/>
                            <RadioMenuFlyoutItem x:Uid="LibraryPage_FolderSortByPath"
                                               Command="{x:Bind ViewModel.SortLibraryCommand}"
                                               CommandParameter="{x:Bind ViewModel.LibraryPathSortKey}"/>
                            <RadioMenuFlyoutItem x:Uid="LibraryPage_FolderSortBySourceType"
                                               Command="{x:Bind ViewModel.SortLibraryCommand}"
                                               CommandParameter="{x:Bind ViewModel.LibrarySourceTypeSortKey}"/>
                            <RadioMenuFlyoutItem x:Uid="LibraryPage_FolderSortByGalgameCount"
                                               Command="{x:Bind ViewModel.SortLibraryCommand}"
                                               CommandParameter="{x:Bind ViewModel.LibraryGalgameCountSortKey}"/>
                            <MenuFlyoutSeparator/>
                            <ToggleMenuFlyoutItem x:Uid="LibraryPage_FolderSortDescending"
                                                 IsChecked="{x:Bind ViewModel.FolderSortDescending, Mode=TwoWay}"
                                                 Command="{x:Bind ViewModel.ApplySortingCommand}"/>
                        </MenuFlyoutSubItem>
                    </MenuFlyout>
                </AppBarButton.Flyout>
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="S"/>
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <!-- <AppBarButton Icon="Share" Label="Share"/> -->
            <CommandBar.SecondaryCommands>
                <!-- 显示导航栏 -->
                <AppBarToggleButton x:Uid="LibraryPage_NavVisible"
                                    IsChecked="{x:Bind ViewModel.IsNavBarVisible, Mode=TwoWay}">
                    <AppBarToggleButton.Icon>
                        <control:ConditionalFontIcon Symbol="Setting" FluentGlyph="&#xE700;"/>
                    </AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <!-- 显示统计数据 -->
                <AppBarToggleButton x:Uid="LibraryPage_StatisticsVisible"
                                    IsChecked="{x:Bind ViewModel.IsStatisticsVisible, Mode=TwoWay}">
                    <AppBarToggleButton.Icon>
                        <control:ConditionalFontIcon Symbol="Setting" FluentGlyph="&#xE8A1;"/>
                    </AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <!-- 游玩状态标记 -->
                <AppBarToggleButton x:Uid="HomePage_DisplayPlayType"
                                    IsChecked="{x:Bind ViewModel.DisplayPlayTypePolygon, Mode=TwoWay}">
                    <AppBarToggleButton.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE890;"/>
                    </AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <AppBarSeparator/>
                <!-- 下载游戏数据 -->
                <AppBarButton Icon="Download"
                              x:Uid="LibraryPage_DownloadAllData"
                              Command="{x:Bind ViewModel.GetInfoFromRssCommand}">
                </AppBarButton>
                <!-- 打开Log文件 -->
                <AppBarButton x:Uid="GalgameFolderPage_Log"
                              IsEnabled="{x:Bind ViewModel.LogExists, Mode=OneWay}"
                              Command="{x:Bind ViewModel.ViewLogCommand}"
                              AllowFocusOnInteraction="True">
                    <AppBarButton.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE81C;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <!-- 面包屑导航栏 -->
        <BreadcrumbBar Grid.Row="1"
                       ItemsSource="{x:Bind ViewModel.PathNodes, Mode=OneWay}"
                       ItemClicked="{x:Bind ViewModel.OnBreadcrumbBarItemClicked}"
                       Visibility="{x:Bind ViewModel.IsNavBarVisible, Mode=OneWay}"
                       Margin="40,8,40,8">
            <BreadcrumbBar.ItemTemplate>
                <DataTemplate x:DataType="sources:GalgameSourceBase">
                    <TextBlock Text="{x:Bind Name}"/>
                </DataTemplate>
            </BreadcrumbBar.ItemTemplate>
        </BreadcrumbBar>

        <Grid Grid.Row="2" PointerPressed="UIElement_OnPointerPressed">
            <ScrollViewer x:Name="LibraryContentScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Sources（支持手动拖拽排序，保留 ItemsRepeater 虚拟化与淡入动画） -->
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Source, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout/>
                        </ItemsRepeater.Layout>
                        <interactivity:Interaction.Behaviors>
                            <behaviors:RepeaterFadeInOnGenerationBehavior
                                FadeDurationMilliseconds="350"
                                Tick="{x:Bind ViewModel.AnimateTick, Mode=OneWay}" />
                            <behaviors:UniformGridAutoColumnSpacingBehavior ItemWidth="175"
                                                                            MinSpacing="10"/>
                        </interactivity:Interaction.Behaviors>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="sources:GalgameSourceBase">
                                <!-- 用 Grid 作为根（Button 会吞掉指针事件导致 CanDrag 无法触发） -->
                                <Grid Width="175"
                                      HorizontalAlignment="Left"
                                      Background="Transparent"
                                      CornerRadius="10"
                                      DataContext="{x:Bind}"
                                      Loaded="SourceItem_Loaded"
                                      DataContextChanged="SourceItem_DataContextChanged"
                                      ContextFlyout="{StaticResource FolderFlyout}"
                                      CanDrag="True"
                                      DragStarting="SourceItem_DragStarting"
                                      AllowDrop="True"
                                      DragOver="SourceItem_DragOver"
                                      Drop="SourceItem_Drop"
                                      Tapped="SourceItem_Tapped"
                                      PointerEntered="SourceItem_PointerEntered"
                                      PointerExited="SourceItem_PointerExited">
                                    <prefab:SourcePrefab Source="{x:Bind}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <!-- Galgames -->
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Galgames, Mode=OneWay}">
                        <interactivity:Interaction.Behaviors>
                            <behaviors:RepeaterFadeInOnGenerationBehavior
                                FadeDurationMilliseconds="350"
                                Tick="{x:Bind ViewModel.AnimateTick, Mode=OneWay}" />
                            <behaviors:UniformGridAutoColumnSpacingBehavior ItemWidth="175"
                                                                            MinSpacing="10"/>
                        </interactivity:Interaction.Behaviors>
                        <ItemsRepeater.Layout>
                            <UniformGridLayout/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:Galgame">
                                <Button Style="{StaticResource TransparentButtonWithHover}"
                                        DataContext="{x:Bind}"
                                        Command="{Binding ElementName=Page, Path=ViewModel.NavigateToCommand}"
                                        CommandParameter="{x:Bind}"
                                        Width="175"
                                        HorizontalAlignment="Left"
                                        ContextFlyout="{StaticResource GameFlyout}">
                                    <prefab:GalgamePrefab Galgame="{x:Bind}"
                                                          PlayTypeVisibility="{Binding ElementName=Page, Path=ViewModel.DisplayPlayTypePolygon, Mode=OneWay}"/>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 添加统计信息悬浮窗 -->
        <InfoBar Grid.Row="2"
                 Visibility="{x:Bind ViewModel.IsStatisticsVisible, Mode=OneWay}"
                 IsOpen="True"
                 IsClosable="False"
                 IsIconVisible="False"
                 Severity="Informational"
                 Message="{x:Bind ViewModel.StatisticsText, Mode=OneWay}"
                 VerticalAlignment="Bottom"
                 HorizontalAlignment="Right"
                 Margin="0,0,24,24"/>
    </Grid>
</Page>
