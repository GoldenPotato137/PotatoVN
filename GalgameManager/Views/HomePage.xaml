<Page
    x:Class="GalgameManager.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:GalgameManager.Models"
    xmlns:converters="using:GalgameManager.Helpers.Converter"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:core="using:Microsoft.Xaml.Interactions.Core"
    xmlns:filters="using:GalgameManager.Models.Filters"
    xmlns:control="using:GalgameManager.Views.Control"
    xmlns:prefab="using:GalgameManager.Views.Prefab"
    xmlns:cmtkControl="using:CommunityToolkit.WinUI.Controls"
    xmlns:cmtk="using:CommunityToolkit.WinUI"
    xmlns:cmtkAnimations="using:CommunityToolkit.WinUI.Animations"
    xmlns:helpers="using:GalgameManager.Helpers"
    xmlns:behaviors="using:GalgameManager.Behaviors"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Converters"
    xmlns:filters1="using:GalgameManager.WinApp.Base.Models.Filters"
    xmlns:viewModels="using:GalgameManager.ViewModels"
    mc:Ignorable="d"
    x:Name="Page"
    NavigationCacheMode="Required">

    <Page.Resources>
        <converters:AnyToVisibilityConverter x:Key="VisibilityConv"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <toolkit:BoolToVisibilityConverter x:Key="InverseBoolToVisConverter" TrueValue="Collapsed" FalseValue="Visible" />
        <helpers:SortKeyToBooleanConverter x:Key="EnumToBoolConverter" />

        <MenuFlyout x:Name="GalFlyout" Opening="{x:Bind ViewModel.GalFlyout_Opening}">
            <!-- 游玩状态管理 -->
            <MenuFlyoutSubItem x:Uid="LibraryPage_PlayStatusSubMenu">
                <MenuFlyoutSubItem.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons"
                              Glyph="&#xE74C;" />
                </MenuFlyoutSubItem.Icon>
                <RadioMenuFlyoutItem x:Uid="LibraryPage_PlayStatusPlaying"
                                     Command="{x:Bind ViewModel.GalFlyOutChangePlayStatusCommand}"
                                     CommandParameter="Playing"
                                     IsChecked="{x:Bind ViewModel.IsCurrentPlayType(ViewModel.CurrentContextGame, 'Playing'), Mode=OneWay}"
                                     GroupName="PlayStatus" />
                <RadioMenuFlyoutItem x:Uid="LibraryPage_PlayStatusPlayed"
                                     Command="{x:Bind ViewModel.GalFlyOutChangePlayStatusCommand}"
                                     CommandParameter="Played"
                                     IsChecked="{x:Bind ViewModel.IsCurrentPlayType(ViewModel.CurrentContextGame, 'Played'), Mode=OneWay}"
                                     GroupName="PlayStatus" />
                <RadioMenuFlyoutItem x:Uid="LibraryPage_PlayStatusOnHold"
                                     Command="{x:Bind ViewModel.GalFlyOutChangePlayStatusCommand}"
                                     CommandParameter="Shelved"
                                     IsChecked="{x:Bind ViewModel.IsCurrentPlayType(ViewModel.CurrentContextGame, 'Shelved'), Mode=OneWay}"
                                     GroupName="PlayStatus" />
                <RadioMenuFlyoutItem x:Uid="LibraryPage_PlayStatusAbandoned"
                                     Command="{x:Bind ViewModel.GalFlyOutChangePlayStatusCommand}"
                                     CommandParameter="Abandoned"
                                     IsChecked="{x:Bind ViewModel.IsCurrentPlayType(ViewModel.CurrentContextGame, 'Abandoned'), Mode=OneWay}"
                                     GroupName="PlayStatus" />
                <RadioMenuFlyoutItem x:Uid="LibraryPage_PlayStatusWantToPlay"
                                     Command="{x:Bind ViewModel.GalFlyOutChangePlayStatusCommand}"
                                     CommandParameter="WantToPlay"
                                     IsChecked="{x:Bind ViewModel.IsCurrentPlayType(ViewModel.CurrentContextGame, 'WantToPlay'), Mode=OneWay}"
                                     GroupName="PlayStatus" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="LibraryPage_PlayStatusMoreSettings"
                                Command="{x:Bind ViewModel.ShowChangePlayStatusDialogCommand}"
                                CommandParameter="{Binding}" />
            </MenuFlyoutSubItem>
            <!-- 编辑游戏信息 -->
            <MenuFlyoutItem Icon="Edit" x:Uid="LibraryPage_Edit" Command="{x:Bind ViewModel.GalFlyOutEditCommand}"
                            CommandParameter="{Binding}" />
            <!-- 下载游戏信息 -->
            <MenuFlyoutItem Icon="Download" x:Uid="LibraryPage_Download"
                            Command="{x:Bind ViewModel.GalFlyOutGetInfoFromRssCommand}" CommandParameter="{Binding}" />
            <!-- 在文件管理器中打开 -->
            <MenuFlyoutSubItem Icon="OpenLocal" x:Uid="LibraryPage_OpenGameInExplorer"
                               Tag="InstallationFolders"/>
            <!-- 删除游戏 -->
            <MenuFlyoutItem Icon="Delete" x:Uid="LibraryPage_Remove"
                            Command="{x:Bind ViewModel.GalFlyOutDeleteCommand}" CommandParameter="{Binding}" />
        </MenuFlyout>
        <MenuFlyout x:Name="BatchFlyout">
            <MenuFlyoutSubItem x:Uid="LibraryPage_PlayStatusSubMenu">
                <MenuFlyoutSubItem.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons"
                              Glyph="&#xE74C;" />
                </MenuFlyoutSubItem.Icon>
                <MenuFlyoutItem x:Uid="LibraryPage_PlayStatusPlaying"
                                Command="{x:Bind ViewModel.BatchChangePlayStatusCommand}"
                                CommandParameter="Playing" />
                <MenuFlyoutItem x:Uid="LibraryPage_PlayStatusPlayed"
                                Command="{x:Bind ViewModel.BatchChangePlayStatusCommand}"
                                CommandParameter="Played" />
                <MenuFlyoutItem x:Uid="LibraryPage_PlayStatusOnHold"
                                Command="{x:Bind ViewModel.BatchChangePlayStatusCommand}"
                                CommandParameter="Shelved" />
                <MenuFlyoutItem x:Uid="LibraryPage_PlayStatusAbandoned"
                                Command="{x:Bind ViewModel.BatchChangePlayStatusCommand}"
                                CommandParameter="Abandoned" />
                <MenuFlyoutItem x:Uid="LibraryPage_PlayStatusWantToPlay"
                                Command="{x:Bind ViewModel.BatchChangePlayStatusCommand}"
                                CommandParameter="WantToPlay" />
            </MenuFlyoutSubItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Icon="Download" x:Uid="LibraryPage_Download"
                            Command="{x:Bind ViewModel.BatchDownloadInfoCommand}" />
            <MenuFlyoutItem Icon="Delete" x:Uid="LibraryPage_Remove"
                            Command="{x:Bind ViewModel.BatchRemoveCommand}" />
        </MenuFlyout>
    </Page.Resources>

    <Grid AllowDrop="True" Drop="{x:Bind ViewModel.Grid_Drop}"
          DragEnter="{x:Bind ViewModel.Grid_DragEnter}" DragLeave="{x:Bind ViewModel.Grid_DragLeave}"
          Margin="0 0 0 20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <CommandBar Grid.Row="0" Background="Transparent" IsOpen="False" DefaultLabelPosition="Right"
                        Margin="{StaticResource CommandBarMargin}">
                <!-- 搜索 -->
                <AppBarElementContainer VerticalAlignment="Center" VerticalContentAlignment="Center">
                    <control:InlineSearchAutoSuggestBox
                        SearchCommand="{x:Bind ViewModel.SearchCommand}"
                        SearchKey="{x:Bind ViewModel.SearchKey, Mode=TwoWay}"
                        SearchSuggestionsProvider="{x:Bind ViewModel.GalgameSearchSuggestionsProvider}" />
                </AppBarElementContainer>
                <!-- 过滤 -->
                <AppBarButton x:Uid="HomePage_Filter" Label="{x:Bind ViewModel.UiFilter, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsBatchMode, Mode=OneWay, Converter={StaticResource InverseBoolToVisConverter}}">
                    <AppBarButton.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE71C;" />
                    </AppBarButton.Icon>
                    <AppBarButton.Flyout>
                        <Flyout Placement="Bottom">
                            <Grid RowDefinitions="*,Auto,Auto" Height="285" Width="400">
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{x:Bind ViewModel.HomeFilterPlayStatusAndSourcePanelColumnWidth, Mode=OneWay}" />
                                        <ColumnDefinition Width="{x:Bind ViewModel.HomeFilterPlayStatusAndSourcePanelGapColumnWidth, Mode=OneWay}" />
                                        <ColumnDefinition Width="{x:Bind ViewModel.HomeFilterEnginePanelColumnWidth, Mode=OneWay}" />
                                        <ColumnDefinition Width="{x:Bind ViewModel.HomeFilterEnginePanelGapColumnWidth, Mode=OneWay}" />
                                        <ColumnDefinition Width="{x:Bind ViewModel.HomeFilterDeveloperPanelColumnWidth, Mode=OneWay}" />
                                        <ColumnDefinition Width="{x:Bind ViewModel.HomeFilterDeveloperPanelGapColumnWidth, Mode=OneWay}" />
                                        <ColumnDefinition Width="{x:Bind ViewModel.HomeFilterTagPanelColumnWidth, Mode=OneWay}" />
                                        <ColumnDefinition Width="{x:Bind ViewModel.HomeFilterTagPanelGapColumnWidth, Mode=OneWay}" />
                                        <ColumnDefinition Width="{x:Bind ViewModel.HomeFilterCategoryPanelColumnWidth, Mode=OneWay}" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,*"
                                          Visibility="{x:Bind ViewModel.HomeFilterShowPlayStatusAndSourcePanel, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Grid.Row="0" x:Uid="HomePage_PlayStatusFilter"
                                                   FontWeight="SemiBold" Margin="{StaticResource XXSmallBottomMargin}"/>
                                        <ComboBox Grid.Row="1" ItemsSource="{x:Bind ViewModel.PlayStatusFilters}"
                                                  SelectedItem="{x:Bind ViewModel.SelectedPlayStatus, Mode=TwoWay}"
                                                  AllowFocusOnInteraction="True" Margin="0 0 0 8"
                                                  HorizontalAlignment="Stretch"/>
                                        <Button Grid.Row="1" Style="{StaticResource TransparentButtonWithHover}"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Visibility="{x:Bind ViewModel.SelectedPlayStatus, Mode=OneWay,
                                                    Converter={StaticResource VisibilityConv}}"
                                                Margin="0 0 30 3"
                                                Command="{x:Bind ViewModel.ClearPlayStatusCommand}">
                                            <control:ConditionalFontIcon FluentGlyph="&#xE711;" Symbol="ClosedCaption"
                                                                         IconFontSize="15"/>
                                        </Button>

                                        <TextBlock Grid.Row="2" x:Uid="HomePage_LibraryFilter"
                                                   FontWeight="SemiBold" Margin="{StaticResource XXSmallBottomMargin}"/>
                                        <ScrollViewer Grid.Row="3">
                                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.SourceFilters}">
                                                <DataTemplate x:DataType="viewModels:HomeViewModelFilter">
                                                    <CheckBox IsThreeState="True"
                                                              IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                                              Content="{x:Bind Title}"/>
                                                </DataTemplate>
                                            </ItemsRepeater>
                                        </ScrollViewer>
                                    </Grid>
                                    <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*"
                                          Visibility="{x:Bind ViewModel.HomeFilterShowEnginePanel, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Grid.Row="0" x:Uid="HomePage_EngineFilter"
                                                     FontWeight="SemiBold" Margin="{StaticResource XXSmallBottomMargin}"/>
                                        <control:SearchAutoSuggestBox Grid.Row="1" MinWidth="0"
                                                                      SearchKey="{x:Bind ViewModel.EngineFilterSearchKey, Mode=TwoWay}"
                                                                      SearchCommand="{x:Bind ViewModel.SearchEngineFilterCommand}"/>
                                        <ScrollViewer Grid.Row="2">
                                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.EngineFilters}">
                                                <DataTemplate x:DataType="viewModels:HomeViewModelFilter">
                                                    <CheckBox IsThreeState="True"
                                                                IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                                                Content="{x:Bind Title}"/>
                                                </DataTemplate>
                                            </ItemsRepeater>
                                        </ScrollViewer>
                                    </Grid>
                                    <Grid Grid.Column="4" RowDefinitions="Auto,Auto,*"
                                          Visibility="{x:Bind ViewModel.HomeFilterShowDeveloperPanel, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Grid.Row="0" x:Uid="HomePage_DeveloperFilter"
                                                   FontWeight="SemiBold" Margin="{StaticResource XXSmallBottomMargin}"/>
                                        <control:SearchAutoSuggestBox Grid.Row="1" MinWidth="0"
                                                                      SearchKey="{x:Bind ViewModel.DeveloperFilterSearchKey, Mode=TwoWay}"
                                                                      SearchCommand="{x:Bind ViewModel.SearchDeveloperFilterCommand}"/>
                                        <ScrollViewer Grid.Row="2">
                                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.DeveloperFilters}">
                                                <DataTemplate x:DataType="viewModels:HomeViewModelFilter">
                                                    <CheckBox IsThreeState="True"
                                                              IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                                              Content="{x:Bind Title}"/>
                                                </DataTemplate>
                                            </ItemsRepeater>
                                        </ScrollViewer>
                                    </Grid>
                                    <Grid Grid.Column="6" RowDefinitions="Auto,Auto,*"
                                          Visibility="{x:Bind ViewModel.HomeFilterShowTagPanel, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Grid.Row="0" x:Uid="HomePage_TagFilter"
                                                   FontWeight="SemiBold" Margin="{StaticResource XXSmallBottomMargin}"/>
                                        <control:SearchAutoSuggestBox SearchKey="{x:Bind ViewModel.TagFilterSearchKey, Mode=TwoWay}"
                                                                      SearchCommand="{x:Bind ViewModel.SearchTagFilterCommand}"
                                                                      MinWidth="0" Grid.Row="1"/>
                                        <ScrollViewer Grid.Row="2">
                                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.TagFilters}">
                                                <DataTemplate x:DataType="viewModels:HomeViewModelFilter">
                                                    <CheckBox IsThreeState="True"
                                                              IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                                              Content="{x:Bind Title}"/>
                                                </DataTemplate>
                                            </ItemsRepeater>
                                        </ScrollViewer>
                                    </Grid>
                                    <Grid Grid.Column="8" RowDefinitions="Auto,Auto,*"
                                          Visibility="{x:Bind ViewModel.HomeFilterCategoryPanelVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Grid.Row="0" x:Uid="HomePage_CategoryFilter"
                                                   FontWeight="SemiBold" Margin="{StaticResource XXSmallBottomMargin}"/>
                                        <control:SearchAutoSuggestBox SearchKey="{x:Bind ViewModel.CategoryFilterSearchKey, Mode=TwoWay}"
                                                                      SearchCommand="{x:Bind ViewModel.SearchCategoryFilterCommand}"
                                                                      MinWidth="0" Grid.Row="1"/>
                                        <ScrollViewer Grid.Row="2">
                                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.CategoryFilters}">
                                                <DataTemplate x:DataType="viewModels:HomeViewModelFilter">
                                                    <CheckBox IsThreeState="True"
                                                              IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                                              Content="{x:Bind Title}"/>
                                                </DataTemplate>
                                            </ItemsRepeater>
                                        </ScrollViewer>
                                    </Grid>
                                </Grid>
                                <Button Grid.Row="0" x:Uid="HomePage_FilterPanelVisibilityButton"
                                        Style="{StaticResource TransparentButtonWithHover}"
                                        Command="{x:Bind ViewModel.ShowHomeFilterPanelVisibilityDialogCommand}"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Margin="0 0 0 4">
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" FontSize="14" />
                                </Button>
                                <Rectangle Grid.Row="1" Height="1" Margin="20 7 20 2"
                                           Fill="{ThemeResource SystemControlForegroundBaseLowBrush}"/>
                                <CheckBox Grid.Row="2" Margin="0 0 0 -11"
                                          RenderTransformOrigin="0,0.5"
                                          IsChecked="{x:Bind ViewModel.KeepFilters, Mode=TwoWay}">
                                    <TextBlock x:Uid="HomePage_KeepFilters" Opacity="0.6"
                                               FontSize="{StaticResource SmallMedFontSize}"/>
                                    <CheckBox.RenderTransform>
                                        <ScaleTransform ScaleX="0.8" ScaleY="0.8"/>
                                    </CheckBox.RenderTransform>
                                </CheckBox>
                                <HyperlinkButton Grid.Row="2" x:Uid="HomePage_ClearFilters"
                                                 FontSize="{StaticResource SmallFontSize}"
                                                 Command="{x:Bind ViewModel.ClearAllFiltersCommand}"
                                                 VerticalAlignment="Center" HorizontalAlignment="Right"
                                                 Margin="0 0 0 -11"/>
                            </Grid>
                            <interactivity:Interaction.Behaviors>
                                <core:EventTriggerBehavior EventName="Opening">
                                    <core:InvokeCommandAction Command="{x:Bind ViewModel.FilterFlyoutOpeningCommand}" />
                                </core:EventTriggerBehavior>
                            </interactivity:Interaction.Behaviors>
                        </Flyout>
                    </AppBarButton.Flyout>
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="K" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <!-- 添加游戏 -->
                <AppBarButton x:Uid="HomePage_AddNewGame" Icon="Add"
                              IsEnabled="{x:Bind ViewModel.IsPhrasing, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}"
                              Visibility="{x:Bind ViewModel.IsBatchMode, Mode=OneWay, Converter={StaticResource InverseBoolToVisConverter}}">
                    <AppBarButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem x:Uid="HomePage_AddNewGame_Local"
                                            Command="{x:Bind ViewModel.AddGalgameCommand}" />
                            <MenuFlyoutItem x:Uid="HomePage_AddNewGame_Virtual"
                                            Command="{x:Bind ViewModel.AddVirtualGameCommand}" />
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="N" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <!-- 全选/取消全选（批量模式） -->
                <AppBarButton Icon="SelectAll"
                              Label="{x:Bind ViewModel.BatchSelectLabel, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsBatchMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                              Click="BatchSelectAll_Click" />
                <!-- 排序 -->
                <AppBarButton x:Uid="HomePage_Sort" Icon="Sort">
                    <AppBarButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <!-- 第一排序键 -->
                            <RadioMenuFlyoutItem x:Uid="HomePage_Sort_Custom"
                                                     Command="{x:Bind ViewModel.SetPrimaryKeyCommand}"
                                                     CommandParameter="Custom"
                                                     GroupName="PrimarySorting"
                                                     IsChecked="{
                                                         x:Bind ViewModel.PrimaryKey, Mode=OneWay,
                                                         Converter={StaticResource EnumToBoolConverter},
                                                         ConverterParameter=Custom
                                                     }" />
                            <RadioMenuFlyoutItem x:Uid="HomePage_Sort_Name"
                                                     Command="{x:Bind ViewModel.SetPrimaryKeyCommand}"
                                                     CommandParameter="Name"
                                                     GroupName="PrimarySorting"
                                                     IsChecked="{
                                                         x:Bind ViewModel.PrimaryKey, Mode=OneWay,
                                                         Converter={StaticResource EnumToBoolConverter},
                                                         ConverterParameter=Name
                                                     }" />
                            <RadioMenuFlyoutItem x:Uid="HomePage_Sort_Developer"
                                                     Command="{x:Bind ViewModel.SetPrimaryKeyCommand}"
                                                     CommandParameter="Developer"
                                                     GroupName="PrimarySorting"
                                                     IsChecked="{
                                                         x:Bind ViewModel.PrimaryKey, Mode=OneWay,
                                                         Converter={StaticResource EnumToBoolConverter},
                                                         ConverterParameter=Developer
                                                     }" />
                            <RadioMenuFlyoutItem x:Uid="HomePage_Sort_Rating"
                                                     Command="{x:Bind ViewModel.SetPrimaryKeyCommand}"
                                                     CommandParameter="Rating"
                                                     GroupName="PrimarySorting"
                                                     IsChecked="{
                                                         x:Bind ViewModel.PrimaryKey, Mode=OneWay,
                                                         Converter={StaticResource EnumToBoolConverter},
                                                         ConverterParameter=Rating
                                                     }" />
                            <RadioMenuFlyoutItem x:Uid="HomePage_Sort_LastPlay"
                                                     Command="{x:Bind ViewModel.SetPrimaryKeyCommand}"
                                                     CommandParameter="LastPlay"
                                                     GroupName="PrimarySorting"
                                                     IsChecked="{
                                                         x:Bind ViewModel.PrimaryKey, Mode=OneWay,
                                                         Converter={StaticResource EnumToBoolConverter},
                                                         ConverterParameter=LastPlay
                                                     }" />
                            <RadioMenuFlyoutItem x:Uid="HomePage_Sort_ReleaseDate"
                                                     Command="{x:Bind ViewModel.SetPrimaryKeyCommand}"
                                                     CommandParameter="ReleaseDate"
                                                     GroupName="PrimarySorting"
                                                     IsChecked="{
                                                         x:Bind ViewModel.PrimaryKey, Mode=OneWay,
                                                         Converter={StaticResource EnumToBoolConverter},
                                                         ConverterParameter=ReleaseDate
                                                     }" />
                            <RadioMenuFlyoutItem x:Uid="HomePage_Sort_LastFetchInfoTime"
                                                     Command="{x:Bind ViewModel.SetPrimaryKeyCommand}"
                                                     CommandParameter="LastFetchInfoTime"
                                                     GroupName="PrimarySorting"
                                                     IsChecked="{
                                                         x:Bind ViewModel.PrimaryKey, Mode=OneWay,
                                                         Converter={StaticResource EnumToBoolConverter},
                                                         ConverterParameter=LastFetchInfoTime
                                                     }" />
                            <RadioMenuFlyoutItem x:Uid="HomePage_Sort_AddTime"
                                                     Command="{x:Bind ViewModel.SetPrimaryKeyCommand}"
                                                     CommandParameter="AddTime"
                                                     GroupName="PrimarySorting"
                                                     IsChecked="{
                                                         x:Bind ViewModel.PrimaryKey, Mode=OneWay,
                                                         Converter={StaticResource EnumToBoolConverter},
                                                         ConverterParameter=AddTime
                                                     }" />
                            <MenuFlyoutSeparator />
                            <ToggleMenuFlyoutItem x:Uid="HomePage_Sort_PrimaryDescending"
                                                      IsChecked="{x:Bind ViewModel.IsPrimaryDescending, Mode=TwoWay}"
                                                      Command="{x:Bind ViewModel.ApplySortCommand}" />
                            <MenuFlyoutSeparator />
                            <!-- 第二排序键 -->
                            <MenuFlyoutSubItem x:Uid="HomePage_Sort_SecondKey">
                                <RadioMenuFlyoutItem x:Uid="HomePage_Sort_Name"
                                                     Command="{x:Bind ViewModel.SetSecondaryKeyCommand}"
                                                     CommandParameter="Name"
                                                     GroupName="SecondarySorting"
                                                     IsChecked="{
                                                         x:Bind ViewModel.SecondaryKey, Mode=OneWay,
                                                         Converter={StaticResource EnumToBoolConverter},
                                                         ConverterParameter=Name
                                                     }" />
                                <RadioMenuFlyoutItem x:Uid="HomePage_Sort_Developer"
                                                     Command="{x:Bind ViewModel.SetSecondaryKeyCommand}"
                                                     CommandParameter="Developer"
                                                     GroupName="SecondarySorting"
                                                     IsChecked="{
                                                         x:Bind ViewModel.SecondaryKey, Mode=OneWay,
                                                         Converter={StaticResource EnumToBoolConverter},
                                                         ConverterParameter=Developer
                                                     }" />
                                <RadioMenuFlyoutItem x:Uid="HomePage_Sort_Rating"
                                                     Command="{x:Bind ViewModel.SetSecondaryKeyCommand}"
                                                     CommandParameter="Rating"
                                                     GroupName="SecondarySorting"
                                                     IsChecked="{
                                                         x:Bind ViewModel.SecondaryKey, Mode=OneWay,
                                                         Converter={StaticResource EnumToBoolConverter},
                                                         ConverterParameter=Rating
                                                     }" />
                                <RadioMenuFlyoutItem x:Uid="HomePage_Sort_LastPlay"
                                                     Command="{x:Bind ViewModel.SetSecondaryKeyCommand}"
                                                     CommandParameter="LastPlay"
                                                     GroupName="SecondarySorting"
                                                     IsChecked="{
                                                         x:Bind ViewModel.SecondaryKey, Mode=OneWay,
                                                         Converter={StaticResource EnumToBoolConverter},
                                                         ConverterParameter=LastPlay
                                                     }" />
                                <RadioMenuFlyoutItem x:Uid="HomePage_Sort_ReleaseDate"
                                                     Command="{x:Bind ViewModel.SetSecondaryKeyCommand}"
                                                     CommandParameter="ReleaseDate"
                                                     GroupName="SecondarySorting"
                                                     IsChecked="{
                                                         x:Bind ViewModel.SecondaryKey, Mode=OneWay,
                                                         Converter={StaticResource EnumToBoolConverter},
                                                         ConverterParameter=ReleaseDate
                                                     }" />
                                <RadioMenuFlyoutItem x:Uid="HomePage_Sort_LastFetchInfoTime"
                                                     Command="{x:Bind ViewModel.SetSecondaryKeyCommand}"
                                                     CommandParameter="LastFetchInfoTime"
                                                     GroupName="SecondarySorting"
                                                     IsChecked="{
                                                         x:Bind ViewModel.SecondaryKey, Mode=OneWay,
                                                         Converter={StaticResource EnumToBoolConverter},
                                                         ConverterParameter=LastFetchInfoTime
                                                     }" />
                                <RadioMenuFlyoutItem x:Uid="HomePage_Sort_AddTime"
                                                     Command="{x:Bind ViewModel.SetSecondaryKeyCommand}"
                                                     CommandParameter="AddTime"
                                                     GroupName="SecondarySorting"
                                                     IsChecked="{
                                                         x:Bind ViewModel.SecondaryKey, Mode=OneWay,
                                                         Converter={StaticResource EnumToBoolConverter},
                                                         ConverterParameter=AddTime
                                                     }" />
                                <MenuFlyoutSeparator />
                                <ToggleMenuFlyoutItem x:Uid="HomePage_Sort_SecondaryDescending"
                                                      IsChecked="{x:Bind ViewModel.IsSecondaryDescending, Mode=TwoWay}"
                                                      Command="{x:Bind ViewModel.ApplySortCommand}" />
                            </MenuFlyoutSubItem>
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="S" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <CommandBar.SecondaryCommands>
                    <AppBarToggleButton x:Uid="HomePage_BatchManage" Icon="AllApps"
                                        IsChecked="{x:Bind ViewModel.IsBatchMode, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.ToggleBatchManageStateCommand}" />
                    <!-- 裁剪横图 -->
                    <AppBarToggleButton x:Uid="HomePage_FixHorizontalPicture" Icon="Crop"
                                        IsChecked="{x:Bind ViewModel.FixHorizontalPicture, Mode=TwoWay}" />
                    <!-- 游玩状态标记 -->
                    <AppBarToggleButton x:Uid="HomePage_DisplayPlayType"
                                        IsChecked="{x:Bind ViewModel.DisplayPlayTypePolygon, Mode=TwoWay}"
                                        Visibility="{x:Bind ViewModel.FixHorizontalPicture, Mode=OneWay}">
                        <AppBarToggleButton.Icon>
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE890;" />
                        </AppBarToggleButton.Icon>
                    </AppBarToggleButton>
                    <!-- 非本地游戏特殊显示 -->
                    <AppBarToggleButton x:Uid="HomePage_SpecialDisplayVirtualGame"
                                        IsChecked="{x:Bind ViewModel.SpecialDisplayVirtualGame, Mode=TwoWay}">
                        <AppBarToggleButton.Icon>
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8FF;" />
                        </AppBarToggleButton.Icon>
                    </AppBarToggleButton>
                    <!-- 显示非本地游戏 -->
                    <AppBarToggleButton x:Uid="HomePage_Filter_DisplayVirtualGames"
                                        IsChecked="{x:Bind ViewModel.DisplayVirtualGame, Mode=TwoWay}">
                        <AppBarToggleButton.Icon>
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE71C;" />
                        </AppBarToggleButton.Icon>
                    </AppBarToggleButton>
                </CommandBar.SecondaryCommands>
            </CommandBar>

            <GridView
                Grid.Row="1" x:Name="GridView"
                ItemsSource="{x:Bind ViewModel.Source, Mode=OneWay}"
                IsItemClickEnabled="{x:Bind ViewModel.IsItemClickEnabled, Mode=OneWay}"
                SelectionMode="{x:Bind ViewModel.GridSelectionMode, Mode=OneWay}"
                IsMultiSelectCheckBoxEnabled="False"
                CanReorderItems="{x:Bind ViewModel.CanReorderItems, Mode=OneWay}"
                AllowDrop="True"
                CanDragItems="{x:Bind ViewModel.CanDragItems, Mode=OneWay}"
                DragItemsStarting="MainGridView_DragItemsStarting"
                DragItemsCompleted="MainGridView_DragItemsCompleted"
                SelectionChanged="MainGridView_SelectionChanged"
                ContainerContentChanging="MainGridView_ContainerContentChanging"
                ItemClick="MainGridView_ItemClick">
                <behaviors:GridViewSpacingBehavior GridView="{x:Bind GridView}"
                                                   TargetWidth="175"
                                                   ItemSource="{x:Bind ViewModel.Source, Mode=OneWay}"
                                                   Calc="True"/>

                <GridView.ItemContainerTransitions>
                    <TransitionCollection>
                        <ReorderThemeTransition />
                    </TransitionCollection>
                </GridView.ItemContainerTransitions>

                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:Galgame">
                        <Grid>
                            <prefab:GalgamePrefab x:Name="GalgamePrefabRoot"
                                Galgame="{x:Bind}"
                                ImageStretch="{Binding ElementName=Page, Path=ViewModel.Stretch, Mode=OneWay}"
                                PlayTypeVisibility="{Binding ElementName=Page, Path=ViewModel.DisplayPlayTypePolygon, Mode=OneWay}"
                                Flyout="{StaticResource GalFlyout}" />
                            <CheckBox x:Name="SelectionCheckBox"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Top"
                                      Margin="6"
                                      Click="SelectionCheckBox_Click"
                                      Visibility="{Binding ElementName=Page, Path=ViewModel.IsMultiSelectCheckBoxEnabled, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <!-- Drag&Drop(用于提示的区域) -->
            <Border Grid.Row="1" CornerRadius="5"
                    Background="{ThemeResource AccentAcrylicBackgroundFillColorBaseBrush}"
                    Visibility="{x:Bind ViewModel.DisplayDragArea, Mode=OneWay}"
                    Opacity="0.6">
                <TextBlock x:Uid="HomePage_DragDrop" Style="{ThemeResource TitleTextBlockStyle}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>

        <Grid
            Row="0"
            Background="#00000000"
            Visibility="{x:Bind ViewModel.IsPhrasing, Mode=OneWay}">
            <ProgressRing
                IsActive="True"
                Width="100"
                Height="100"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Page>
