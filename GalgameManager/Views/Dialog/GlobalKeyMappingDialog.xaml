
<ContentDialog
    x:Class="GalgameManager.Views.Dialog.GlobalKeyMappingDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:GalgameManager.Models"
    xmlns:control="using:GalgameManager.Views.Control"
    xmlns:converter="using:GalgameManager.Helpers.Converter"
    Style="{ThemeResource DefaultContentDialogStyle}"
    mc:Ignorable="d"
    DefaultButton="Primary">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">760</x:Double>
    </ContentDialog.Resources>

    <StackPanel Spacing="10">
        <InfoBar x:Name="GlobalMappingInfoBar"
                 IsOpen="True"
                 IsClosable="False"
                 Severity="Informational" />

        <!-- 输入模式切换 -->
        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           x:Uid="KeyMappingDialog_InputMode"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0" />

                <ToggleSwitch Grid.Column="1"
                             x:Name="InputModeToggle"
                             x:Uid="KeyMappingDialog_InputModeToggle"
                             Toggled="InputModeToggle_Toggled"
                             Margin="0" 
                             IsEnabled="{x:Bind HasMappings, Mode=OneWay}"/>
            </Grid>
        </Border>

        <!-- 表格容器 -->
        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 表头 -->
                <Border Grid.Row="0" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" x:Uid="KeyMappingDialog_Header_Description" HorizontalAlignment="Left" VerticalAlignment="Center"
                                   FontWeight="SemiBold" Margin="10,8" />
                        <TextBlock Grid.Column="1" x:Uid="KeyMappingDialog_Header_FromKey" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" x:Uid="KeyMappingDialog_Header_ToKey" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" x:Uid="KeyMappingDialog_Header_Enabled" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontWeight="SemiBold" />
                        <TextBlock Grid.Column="4" x:Uid="KeyMappingDialog_Header_Delete" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontWeight="SemiBold" />
                    </Grid>
                </Border>

                <!-- 数据行容器 -->
                <ScrollViewer x:Name="MappingScrollViewer"
                              Grid.Row="1"
                              MaxHeight="320"
                              MinHeight="160"
                              MinWidth="610"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{x:Bind Mappings, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:KeyMapping">
                                <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition Width="50" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 说明列 -->
                                        <control:SearchableTextBox Grid.Column="0" Text="{x:Bind Remark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 VerticalAlignment="Center" MinWidth="150" Margin="2,0,0,0"
                                                 BorderThickness="1"
                                                 BorderBrush="{ThemeResource TextControlBorderBrush}"
                                                 Background="{ThemeResource TextControlBackground}"/>

                                        <!-- 设置按键列 -->
                                        <control:FlexibleHotkeyInputBox Grid.Column="1"
                                                                       HotkeyKeys="{x:Bind From, Mode=TwoWay}"
                                                                       Margin="5"/>

                                        <!-- 目标按键列 -->
                                        <control:FlexibleHotkeyInputBox Grid.Column="2"
                                                                       HotkeyKeys="{x:Bind To, Mode=TwoWay}"
                                                                       Margin="5"/>

                                        <!-- 开关列 -->
                                        <ToggleSwitch Grid.Column="3" IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    Margin="2,2"
                                                    MinWidth="0"/>

                                        <!-- 删除列 -->
                                        <Button Grid.Column="4" Click="DeleteButton_Click"
                                              Tag="{x:Bind}"
                                              VerticalAlignment="Center"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              HorizontalAlignment="Center"
                                              Padding="0"
                                              Width="30" Height="30">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74D;" FontSize="18"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Button Click="AddMappingButton_Click" HorizontalAlignment="Stretch" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <SymbolIcon Symbol="Add" />
                <TextBlock x:Uid="KeyMappingDialog_Button_AddMapping" />
            </StackPanel>
        </Button>
    </StackPanel>
</ContentDialog>
