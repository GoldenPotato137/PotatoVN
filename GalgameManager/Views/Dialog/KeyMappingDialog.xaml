<ContentDialog
    x:Class="GalgameManager.Views.Dialog.KeyMappingDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:GalgameManager.Models"
    xmlns:control="using:GalgameManager.Views.Control"
    xmlns:converter="using:GalgameManager.Helpers.Converter"
    Style="{ThemeResource DefaultContentDialogStyle}"
    mc:Ignorable="d"
    DefaultButton="Primary">

    <ContentDialog.Resources>
        <converter:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <converter:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <x:Double x:Key="ContentDialogMinWidth">600</x:Double>
    </ContentDialog.Resources>

    <StackPanel Spacing="10">
        <InfoBar x:Name="KeyMappingActivationInfoBar"
                 IsOpen="True"
                 IsClosable="False"
                 Severity="Warning">
            <InfoBar.Content>
                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Left"
                            Margin="0,8,0,0">
                    <Button x:Name="EnableGameKeyMappingButton"
                            x:Uid="KeyMappingDialog_Activation_EnableGame"
                            Click="EnableGameKeyMappingButton_Click" />
                    <Button x:Name="EnableGlobalKeyMappingButton"
                            x:Uid="KeyMappingDialog_Activation_EnableGlobal"
                            Click="EnableGlobalKeyMappingButton_Click" />
                    <Button x:Uid="KeyMappingDialog_Activation_EditGlobal"
                            Click="EditGlobalKeyMappingButton_Click" />
                </StackPanel>
            </InfoBar.Content>
        </InfoBar>

        <!-- 输入模式切换 -->
        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           x:Uid="KeyMappingDialog_InputMode"
                           VerticalAlignment="Center"                         
                           Margin="10,0,0,0" />

                <ToggleSwitch Grid.Column="1"
                             x:Name="InputModeToggle"
                             x:Uid="KeyMappingDialog_InputModeToggle"
                             Toggled="InputModeToggle_Toggled"
                             Margin="0"
                             IsEnabled="{x:Bind HasMappings, Mode=OneWay}"/>
            </Grid>
        </Border>

        <!-- 表格容器 -->
        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 表头 -->
                <Border Grid.Row="0" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="150" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" x:Uid="KeyMappingDialog_Header_Description" HorizontalAlignment="Left" VerticalAlignment="Center"
                                   FontWeight="SemiBold" Margin="10,8" />
                        <TextBlock Grid.Column="1" x:Uid="KeyMappingDialog_Header_FromKey" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" x:Uid="KeyMappingDialog_Header_ToKey" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" x:Uid="KeyMappingDialog_Header_Enabled" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontWeight="SemiBold" />
                        <TextBlock Grid.Column="4" x:Uid="KeyMappingDialog_Header_Delete" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontWeight="SemiBold" />
                    </Grid>
                </Border>

                <!-- 数据行容器 -->
                <ScrollViewer x:Name="MappingScrollViewer"
                              Grid.Row="1"
                              MaxHeight="250"
                              MinHeight="120"
                              MinWidth="800"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{x:Bind DialogKeyMappings, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:KeyMapping">
                                <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition Width="50" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 说明列 -->
                                        <Grid Grid.Column="0">
                                            <!-- 全局快捷键的红色角标 -->
                                            <Path Data="M 0,0 L 20,0 L 0,20 Z"
                                                  Fill="#FF0000"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Top"
                                                  Visibility="{x:Bind IsGlobal, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <control:SearchableTextBox Text="{x:Bind Remark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                   IsEnabled="{x:Bind IsGlobal, Converter={StaticResource InverseBooleanConverter}}"
                                                   VerticalAlignment="Center" MinWidth="120" Margin="5"/>
                                        </Grid>

                                        <!-- 设置按键列 -->
                                        <control:FlexibleHotkeyInputBox Grid.Column="1"
                                                                       HotkeyKeys="{x:Bind From, Mode=TwoWay}"
                                                                       IsEnabled="{x:Bind IsGlobal, Converter={StaticResource InverseBooleanConverter}}"
                                                                       Margin="5"/>

                                        <!-- 游戏中按键列 -->
                                        <control:FlexibleHotkeyInputBox Grid.Column="2"
                                                                       HotkeyKeys="{x:Bind To, Mode=TwoWay}"
                                                                       IsEnabled="{x:Bind IsGlobal, Converter={StaticResource InverseBooleanConverter}}"
                                                                       Margin="5"/>

                                        <!-- 开关列 -->
                                        <ToggleSwitch Grid.Column="3" IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    Margin="5,2"
                                                    MinWidth="0"/>

                                        <!-- 删除列 -->
                                        <Button Grid.Column="4" Click="DeleteButton_Click"
                                              Tag="{x:Bind}"
                                              IsEnabled="{x:Bind IsGlobal, Converter={StaticResource InverseBooleanConverter}}"
                                              ToolTipService.ToolTip="{Binding KeyMappingDialog_Button_Delete_ToolTip, ElementName=dialog}"
                                              VerticalAlignment="Center"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              HorizontalAlignment="Center"
                                              Padding="3"
                                              Width="30" Height="30">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74D;" FontSize="14"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Button Click="AddKeyMappingButton_Click" HorizontalAlignment="Stretch" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <SymbolIcon Symbol="Add"/>
                <TextBlock x:Uid="KeyMappingDialog_Button_AddMapping"/>
            </StackPanel>
        </Button>
    </StackPanel>
</ContentDialog>
