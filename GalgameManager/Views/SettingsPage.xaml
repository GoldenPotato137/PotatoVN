<Page
    x:Class="GalgameManager.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:GalgameManager.Views"
    xmlns:converter="using:GalgameManager.Helpers.Converter"
    xmlns:control="using:GalgameManager.Views.Control"
    xmlns:enums="using:GalgameManager.Enums"
    xmlns:models="using:GalgameManager.Models"
    xmlns:cmtkConverters="using:CommunityToolkit.WinUI.Converters"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <converter:RssTypeToVisibilityConverter x:Key="RssTypeToVisibilityConverter"/>
        <converter:AuthenticationTypeToStringConverter x:Key="AuthenticationTypeToStringConverter"/>
        <converter:WindowModeToStringConverter x:Key="WindowModeToStringConverter"/>
        <converter:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converter:EnumToStringConverter x:Key="EnumToStringConverter"/>
        <cmtkConverters:StringVisibilityConverter x:Key="StringVisibilityConverter"/>
        <Style x:Key="SettingStackPanelStyle" TargetType="StackPanel">
            <Setter Property="Spacing" Value="13" />
            <Setter Property="Orientation" Value="Vertical" />
        </Style>
        <x:Double x:Key="ToggleSwitchWidth">20</x:Double>
        <x:Double x:Key="ButtonMinWidth">75</x:Double>
    </Page.Resources>


    <Grid Margin="0 0 0 40">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0 10 25 0">

                <!-- 外观 -->
                <control:SettingExpander SettingTitle="{x:Bind ViewModel.UiThemeTitle}"
                                         SettingDescription="{x:Bind ViewModel.UiThemeDescription}"
                                         SettingIcon="&#xE790;">
                    <control:SettingExpander.SettingContent>
                        <StackPanel Style="{StaticResource SettingStackPanelStyle}">
                            <!-- 主题颜色 -->
                            <control:Panel>
                                <RelativePanel>
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock x:Uid="SettingsPage_Theme_Color"
                                                   Style="{ThemeResource BodyTextBlockStyle}" />
                                        <TextBlock x:Uid="SettingsPage_Theme_Color_Description"
                                                   Style="{StaticResource DescriptionTextStyle}" />
                                    </StackPanel>
                                    <ComboBox ItemsSource="{x:Bind ViewModel.Themes}"
                                              SelectedItem="{x:Bind ViewModel.ElementTheme, Mode=TwoWay}"
                                              RelativePanel.AlignRightWithPanel="True">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="ElementTheme">
                                                <TextBlock Text="{x:Bind Converter={StaticResource EnumToStringConverter}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </RelativePanel>
                            </control:Panel>
                            <!--  窗口背景材质  -->
                            <control:Panel>
                                <RelativePanel>
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock x:Uid="SettingsPage_Theme_WindowBackgroundMaterial"
                                                   Style="{ThemeResource BodyTextBlockStyle}" />
                                        <TextBlock x:Uid="SettingsPage_Theme_WindowBackgroundMaterial_Description"
                                                   Style="{StaticResource DescriptionTextStyle}" />
                                    </StackPanel>
                                    <ComboBox ItemsSource="{x:Bind ViewModel.BackgroundMaterials}"
                                              SelectedItem="{x:Bind ViewModel.BackgroundMaterial, Mode=TwoWay}"
                                              RelativePanel.AlignRightWithPanel="True">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="enums:BackgroundMaterialEnum">
                                                <TextBlock Text="{x:Bind Converter={StaticResource EnumToStringConverter}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </RelativePanel>
                            </control:Panel>
                            <!-- 透明玻璃 -->
                            <control:Panel Visibility="{x:Bind ViewModel.IsGlassMaterial, Mode=OneWay}">
                                <StackPanel Orientation="Vertical" Spacing="8">
                                    <TextBlock x:Uid="SettingsPage_Theme_GlassAlpha"
                                               Style="{ThemeResource BodyTextBlockStyle}" />
                                    <Slider Minimum="0" Maximum="255" TickFrequency="1"
                                            Value="{x:Bind ViewModel.GlassAlpha, Mode=TwoWay}" />
                                    <TextBlock x:Uid="SettingsPage_Theme_GlassColor"
                                               Style="{ThemeResource BodyTextBlockStyle}" />
                                    <ColorPicker Color="{x:Bind ViewModel.GlassColor, Mode=TwoWay}"
                                                 IsAlphaEnabled="False" />
                                </StackPanel>
                            </control:Panel>
                            <!-- 自定义背景图片 -->
                            <control:Panel>
                                <StackPanel Orientation="Vertical" Spacing="8">
                                    <TextBlock x:Uid="SettingsPage_Theme_CustomBackground"
                                               Style="{ThemeResource BodyTextBlockStyle}" />
                                    <local:SettingToggleSwitch x:Uid="SettingsPage_Theme_UseBannerBackground"
                                                               IsOn="{x:Bind ViewModel.UseBannerAsBackground, Mode=TwoWay}" />
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Button x:Uid="SettingsPage_Theme_PickBackground"
                                                Command="{x:Bind ViewModel.PickCustomBackgroundCommand}" />
                                        <Button x:Uid="SettingsPage_Theme_ClearBackground"
                                                Command="{x:Bind ViewModel.ClearCustomBackgroundCommand}" />
                                    </StackPanel>
                                    <!-- 图片模式 -->
                                    <RelativePanel>
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock x:Uid="SettingsPage_Theme_BackgroundStretchMode"
                   Style="{ThemeResource BodyTextBlockStyle}" />
                                        </StackPanel>
                                        <ComboBox ItemsSource="{x:Bind ViewModel.BackgroundStretchModes}"
              SelectedItem="{x:Bind ViewModel.BackgroundStretchMode, Mode=TwoWay}"
              RelativePanel.AlignRightWithPanel="True">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="enums:BackgroundStretchMode">
                                                    <TextBlock Text="{x:Bind Converter={StaticResource EnumToStringConverter}}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </RelativePanel>
                                </StackPanel>
                            </control:Panel>
                            
                            <!-- 导航视图透明背景 -->
                            <control:Panel>
                                <local:SettingToggleSwitch x:Uid="SettingsPage_Theme_TransparentNavigationView"
                                                           IsOn="{x:Bind ViewModel.TransparentNavigationView, Mode=TwoWay}"/>
                            </control:Panel>
                            <!-- 软件语言 -->
                            <control:Panel>
                                <RelativePanel>
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock x:Uid="SettingsPage_Theme_Language"
                                                   Style="{ThemeResource BodyTextBlockStyle}" />
                                        <TextBlock x:Uid="SettingsPage_Theme_Language_Description"
                                                   Style="{StaticResource DescriptionTextStyle}" />
                                    </StackPanel>
                                    <ComboBox ItemsSource="{x:Bind ViewModel.Languages}"
                                              SelectedItem="{x:Bind ViewModel.Language, Mode=TwoWay}"
                                              RelativePanel.AlignRightWithPanel="True">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="enums:LanguageEnum">
                                                <TextBlock Text="{x:Bind Converter={StaticResource EnumToStringConverter}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </RelativePanel>
                            </control:Panel>
                            <!-- 修复横向图片 -->
                            <control:Panel>
                                <local:SettingToggleSwitch x:Uid="SettingsPage_Theme_FixHorizontalPicture"
                                                           IsOn="{x:Bind ViewModel.FixHorizontalPicture, Mode=TwoWay}" />
                            </control:Panel>
                            <!-- 时间显示单位改为小时 -->
                            <control:Panel>
                                <local:SettingToggleSwitch x:Uid="SettingsPage_Theme_TimeAsHour"
                                                           IsOn="{x:Bind ViewModel.TimeAsHour, Mode=TwoWay}"/>
                            </control:Panel>
                            <!-- 游戏控件是否显示游戏名称 -->
                            <control:Panel>
                                <local:SettingToggleSwitch x:Uid="SettingsPage_Theme_ShowGameNameInControl"
                                                           IsOn="{x:Bind ViewModel.ShowGameNameInControl, Mode=TwoWay}"/>
                            </control:Panel>
                            <!-- 默认显示的游戏名 -->
                            <control:Panel>
                                <control:Setting x:Uid="SettingsPage_Theme_DefaultGameName">
                                    <ComboBox MinWidth="{StaticResource ToggleSwitchWidth}"
                                              ItemsSource="{x:Bind ViewModel.DefaultGameNames}"
                                              SelectedItem="{x:Bind ViewModel.DefaultGameName, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:DisplayName">
                                                <TextBlock Text="{x:Bind Converter={StaticResource EnumToStringConverter}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </control:Setting>
                            </control:Panel>
                            <!-- 侧边栏按钮显示设置 -->
                            <control:Panel>
                                <control:Setting x:Uid="SettingsPage_Theme_SidebarButtons">
                                    <Button Content="Go"
                                            MinWidth="{StaticResource ButtonMinWidth}"
                                            Command="{x:Bind ViewModel.ManageSidebarButtonsCommand}"/>
                                </control:Setting>
                            </control:Panel>
                        </StackPanel>
                    </control:SettingExpander.SettingContent>
                </control:SettingExpander>

                <!-- 下载行为 -->
                <control:SettingExpander
                    SettingTitle="{x:Bind ViewModel.UiDownloadTitle}"
                    SettingDescription="{x:Bind ViewModel.UiDownloadDescription}"
                    SettingIcon="&#xE896;">
                    <control:SettingExpander.SettingContent>
                        <StackPanel Style="{StaticResource SettingStackPanelStyle}">
                            <!-- 信息源 -->
                            <control:Panel>
                                <RelativePanel>
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Text="{x:Bind ViewModel.UiRssTitle}"
                                                   Style="{ThemeResource BodyTextBlockStyle}"/>
                                        <TextBlock Text="{x:Bind ViewModel.UiRssDescription}"
                                                   Style="{StaticResource DescriptionTextStyle}"/>
                                    </StackPanel>
                                    <control:ComboBoxWithI18N ItemsSource="{x:Bind ViewModel.RssTypes}"
                                              SelectedItem="{x:Bind ViewModel.RssType, Mode=TwoWay}"
                                              RelativePanel.AlignRightWithPanel="True"/>
                                </RelativePanel>
                            </control:Panel>
                            <!-- bangumi -->
                            <control:Panel Visibility="{x:Bind ViewModel.RssType, Mode=OneWay, Converter={StaticResource RssTypeToVisibilityConverter}, ConverterParameter=Bangumi}">
                                <StackPanel>
                                    <HyperlinkButton x:Uid="SettingsPage_Rss_Bangumi"
                                            Padding="0"/>
                                    <TextBlock x:Uid="SettingsPage_Rss_Bangumi_Description"
                                            TextWrapping="Wrap"
                                               Style="{StaticResource DescriptionTextStyle}"
                                               Margin="{StaticResource XSmallBottomMargin}"/>
                                </StackPanel>
                            </control:Panel>
                            <!-- VNDB -->
                            <control:Panel
                                Visibility="{x:Bind ViewModel.RssType, Mode=OneWay, Converter={StaticResource RssTypeToVisibilityConverter}, ConverterParameter=Vndb}">
                                <StackPanel>
                                    <HyperlinkButton x:Uid="SettingsPage_Rss_VNDB"
                                            Padding="0"/>
                                     <TextBlock x:Uid="SettingsPage_Rss_VNDB_Description"
                                             TextWrapping="Wrap"
                                                Style="{StaticResource DescriptionTextStyle}"
                                                Margin="{StaticResource XSmallBottomMargin}"/>
                                     <local:SettingToggleSwitch x:Uid="SettingsPage_Rss_VNDB_TranslateTags"
                                                                IsOn="{x:Bind ViewModel.VndbTranslateTags, Mode=TwoWay}"
                                                                Visibility="{x:Bind ViewModel.IsChineseCulture, Mode=OneWay,
                                                                Converter={StaticResource BoolToVisibilityConverter}}"/>
                                     <local:SettingToggleSwitch x:Uid="SettingsPage_Rss_VNDB_CensorTags"
                                                                IsOn="{x:Bind ViewModel.VndbCensorTags, Mode=TwoWay}"/>
                                     <local:SettingToggleSwitch x:Uid="SettingsPage_Rss_VNDB_RemoveSpoilerTags"
                                                                IsOn="{x:Bind ViewModel.VndbRemoveSpoilerTags, Mode=TwoWay}"/>
                                 </StackPanel>
                             </control:Panel>
                            <!-- Hikarinagi -->
                            <control:Panel
                                Visibility="{x:Bind ViewModel.RssType, Mode=OneWay, Converter={StaticResource RssTypeToVisibilityConverter}, ConverterParameter=Hikarinagi}">
                                <StackPanel>
                                    <HyperlinkButton x:Uid="SettingsPage_Rss_Hikarinagi"
                                            Padding="0"/>
                                    <TextBlock x:Uid="SettingsPage_Rss_Hikarinagi_Description"
                                            TextWrapping="Wrap"
                                               Style="{StaticResource DescriptionTextStyle}"
                                               Margin="{StaticResource XSmallBottomMargin}"/>
                                </StackPanel>
                            </control:Panel>
                            <!-- Mixed -->
                            <control:Panel
                                Visibility="{x:Bind ViewModel.RssType, Mode=OneWay, Converter={StaticResource RssTypeToVisibilityConverter}, ConverterParameter=Mixed}">
                                <StackPanel Style="{StaticResource SettingStackPanelStyle}">
                                    <HyperlinkButton x:Uid="SettingsPage_Rss_Mixed"
                                            Padding="0"/>
                                    <TextBlock x:Uid="SettingsPage_Rss_Mixed_Description"
                                            TextWrapping="Wrap"
                                               Style="{StaticResource DescriptionTextStyle}"
                                               Margin="{StaticResource XSmallBottomMargin}"/>
                                    <control:Setting x:Uid="SettingsPage_Rss_Mixed_Order">
                                        <Button Content="Go"
                                                MinWidth="{StaticResource ButtonMinWidth}"
                                                Command="{x:Bind ViewModel.SetMixedPhraserOrderCommand}"/>
                                    </control:Setting>
                                    <control:Setting x:Uid="SettingsPage_Rss_Mixed_Enable">
                                         <Button Content="Go"
                                                 MinWidth="{StaticResource ButtonMinWidth}"
                                                 Command="{x:Bind ViewModel.SetMixedPhraserEnabledCommand}"/>
                                     </control:Setting>
                                     <control:Setting x:Uid="SettingsPage_Rss_Mixed_Timeout">
                                         <NumberBox Value="{x:Bind ViewModel.MixedPhraserTimeout, Mode=TwoWay}"
                                                    SpinButtonPlacementMode="Compact"
                                                    SmallChange="5" LargeChange="30" Minimum="0" Maximum="300"
                                                    Width="100"/>
                                     </control:Setting>
                                     <local:SettingToggleSwitch x:Uid="SettingsPage_Rss_VNDB_TranslateTags"
                                                                IsOn="{x:Bind ViewModel.VndbTranslateTags, Mode=TwoWay}"
                                                                Visibility="{x:Bind ViewModel.IsChineseCulture, Mode=OneWay,
                                                                Converter={StaticResource BoolToVisibilityConverter}}"/>
                                     <local:SettingToggleSwitch x:Uid="SettingsPage_Rss_VNDB_CensorTags"
                                                                IsOn="{x:Bind ViewModel.VndbCensorTags, Mode=TwoWay}"/>
                                     <local:SettingToggleSwitch x:Uid="SettingsPage_Rss_VNDB_RemoveSpoilerTags"
                                                                IsOn="{x:Bind ViewModel.VndbRemoveSpoilerTags, Mode=TwoWay}"/>
                                 </StackPanel>
                             </control:Panel>

                            <control:Panel>
                                <StackPanel>
                                    <!-- 忽略游戏查询结果 -->
                                    <local:SettingToggleSwitch x:Uid="SettingsPage_Library_IgnoreFetchResult"
                                                                IsOn="{x:Bind ViewModel.IgnoreFetchResult, Mode=TwoWay}"
                                                                Margin="0, 0, 0, 13"/>

                                    <!-- 下载游戏角色信息 -->
                                    <local:SettingToggleSwitch x:Uid="SettingsPage_Download_Character"
                                                                IsOn="{x:Bind ViewModel.DownloadCharacters, Mode=TwoWay}"/>
                                    <!-- 覆盖名字
                                    <local:SettingToggleSwitch x:Uid="SettingsPage_Download_OverrideName"
                                    IsOn="{x:Bind ViewModel.OverrideLocalName, Mode=TwoWay}" />
                                    <local:SettingToggleSwitch x:Uid="SettingsPage_Download_OverrideNameWithChinese"
                                                               IsOn="{x:Bind ViewModel.OverrideLocalNameWithChinese, Mode=TwoWay}"
                                                               Visibility="{x:Bind ViewModel.OverrideLocalName, Mode=OneWay}"
                                                               Margin="0, 13, 0, 0"
                                    /> -->
                                    <!-- Magic Number: SettingsPageStackPanelSpacing=13 修复SettingToggleSwitch隐藏时 StackPanel 下侧仍有Spacing 问题 -->
                                </StackPanel>
                            </control:Panel>
                            <!-- 自动分类 -->
                            <control:Panel>
                                <StackPanel Spacing="{StaticResource SettingsPageStackPanelSpacing}">
                                  <local:SettingToggleSwitch x:Uid="SettingsPage_Download_AutoCategory"
                                                               IsOn="{x:Bind ViewModel.AutoCategory, Mode=TwoWay}"/>
                                  <control:Setting x:Uid="SettingsPage_Download_CategoryNow">
                                      <Button Content="Go" Width="75" Command="{x:Bind ViewModel.CategoryNowCommand}">
                                          <Button.Flyout>
                                              <Flyout Placement="Bottom">
                                                  <TextBlock Text="Done!"/>
                                              </Flyout>
                                          </Button.Flyout>
                                      </Button>
                                  </control:Setting>
                                </StackPanel>
                            </control:Panel>
                            <!-- 游玩状态同步 -->
                            <control:Panel>
                                <StackPanel Spacing="{StaticResource SettingsPageStackPanelSpacing}">
                                    <local:SettingToggleSwitch x:Uid="SettingsPage_Download_SyncPlayStatusWhenPhrasing"
                                                               IsOn="{x:Bind ViewModel.DownloadPlayStatusWhenPhrasing, Mode=TwoWay}"/>

                                    <control:Setting x:Uid="SettingsPage_Download_SyncBgmPlayStatusNow">
                                        <Button Content="Go" Width="75" Command="{x:Bind ViewModel.DownloadPlayStatusFormBgmNowCommand}"/>
                                    </control:Setting>

                                    <control:Setting x:Uid="SettingsPage_Download_SyncVndbPlayStatusNow">
                                        <Button Content="Go" Width="75" Command="{x:Bind ViewModel.DownloadPlayStatusFormVndbNowCommand}"/>
                                    </control:Setting>
                                    <control:Setting Title="上传所有游戏游玩状态"
                                                     Description="一键上传所有游戏的游玩状态到bangumi和vndb">
                                        <Button Content="Go" Width="75" Command="{x:Bind ViewModel.UploadAllPlayStatusCommand}"/>
                                    </control:Setting>
                                </StackPanel>
                            </control:Panel>
                        </StackPanel>
                    </control:SettingExpander.SettingContent>
                </control:SettingExpander>

                <!-- 游玩 -->
                <control:SettingExpander
                    x:Uid="SettingsPage_Game"
                    SettingIcon="&#xE7FC;">
                    <control:SettingExpander.SettingContent>
                        <StackPanel Style="{StaticResource SettingStackPanelStyle}">
                            <!-- 只记录前台时间 -->
                            <control:Panel>
                                <local:SettingToggleSwitch
                                    x:Uid="SettingsPage_Game_RecordOnlyForeground"
                                    IsOn="{x:Bind ViewModel.RecordOnlyForeground, Mode=TwoWay}"/>
                            </control:Panel>
                            <!-- 游玩时窗口状态 -->
                            <control:Panel>
                                <control:Setting x:Uid="SettingsPage_Game_PlayingWindowMode">
                                    <ComboBox MinWidth="{StaticResource ToggleSwitchWidth}"
                                              ItemsSource="{x:Bind ViewModel.PlayingWindowModes}"
                                              SelectedItem="{x:Bind ViewModel.PlayingWindowMode, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="enums:WindowMode">
                                                <TextBlock Text="{x:Bind Converter={StaticResource WindowModeToStringConverter}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </control:Setting>
                            </control:Panel>
                            <!-- LocaleEmulator -->
                            <control:Panel>
                                <StackPanel>
                                    <control:Setting  x:Uid="SettingsPage_Game_LocaleEmulator">
                                        <Button Content="Go"
                                                MinWidth="{StaticResource ButtonMinWidth}"
                                                Command="{x:Bind ViewModel.SelectLocalEmulatorPathCommand}"/>
                                    </control:Setting>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                                Visibility="{x:Bind ViewModel.LocalEmulatorPath, Mode=OneWay,
                                                Converter={StaticResource StringVisibilityConverter}}">
                                        <TextBlock x:Uid="SettingsPage_Game_LocaleEmulator_PathDescription"/>
                                        <TextBlock Text="{x:Bind ViewModel.LocalEmulatorPath, Mode=OneWay}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </control:Panel>
                            <!-- Magpie -->
                            <control:Panel>
                                <StackPanel Style="{StaticResource SettingStackPanelStyle}">
                                    <!-- 总开关 -->
                                    <local:SettingToggleSwitch x:Uid="SettingsPage_Game_Magpie_TotalSwitch"
                                        IsOn="{x:Bind ViewModel.MagpieTotalSwitch, Mode=TwoWay}"/>
                                    <!-- Magpie路径 -->
                                    <StackPanel Visibility="{x:Bind ViewModel.MagpieTotalSwitch, Mode=OneWay}">
                                        <control:Setting x:Uid="SettingsPage_Game_Magpie">
                                            <Button Content="Go"
                                                    MinWidth="{StaticResource ButtonMinWidth}"
                                                    Command="{x:Bind ViewModel.SelectMagpiePathCommand}"/>
                                        </control:Setting>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                                    Visibility="{x:Bind ViewModel.MagpiePath, Mode=OneWay,
                                                Converter={StaticResource StringVisibilityConverter}}">
                                            <TextBlock x:Uid="SettingsPage_Game_Magpie_PathDescription"/>
                                            <TextBlock Text="{x:Bind ViewModel.MagpiePath, Mode=OneWay}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Rectangle Height="1"  Margin="0 2 0 5"
                                               Visibility="{x:Bind ViewModel.MagpieSettingVisible, Mode=OneWay}"
                                               Fill="{ThemeResource SystemControlForegroundBaseLowBrush}"/>
                                    <!-- Magpie快捷键 -->
                                    <StackPanel Visibility="{x:Bind ViewModel.MagpieSettingVisible, Mode=OneWay}">
                                        <TextBlock x:Uid="SettingsPage_Game_MagpieHotkeys_Title"/>
                                        <TextBlock x:Uid="SettingsPage_Game_MagpieHotkeys_Description"
                                                   Style="{ThemeResource DescriptionTextStyle}"/>
                                        <control:HotkeyInputBox x:Uid="SettingsPage_Game_MagpieHotkeys_HotkeyInputBox"
                                            HotkeyKeys="{x:Bind ViewModel.MagpieHotkeyKeys, Mode=TwoWay}"
                                                               Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Rectangle Height="1" Margin="0 2 0 5"
                                               Fill="{ThemeResource SystemControlForegroundBaseLowBrush}"
                                               Visibility="{x:Bind ViewModel.MagpieSettingVisible, Mode=OneWay}"/>
                                    <!-- 始终启用 Magpie -->
                                    <local:SettingToggleSwitch
                                        x:Uid="SettingsPage_AlwaysEnableMagpie"
                                        IsOn="{x:Bind ViewModel.AlwaysEnableMagpie, Mode=TwoWay}"
                                        Visibility="{x:Bind ViewModel.MagpieSettingVisible, Mode=OneWay}"/>
                                </StackPanel>
                            </control:Panel>
                            <!-- 始终后台时静音游戏 -->
                            <control:Panel>
                                <local:SettingToggleSwitch
                                    x:Uid="Settings_Game_AlwaysMuteInBackground"
                                    IsOn="{x:Bind ViewModel.AlwaysMuteInBackground, Mode=TwoWay}"/>
                            </control:Panel>
                            <!-- 游戏快捷键映射 -->
                            <control:Panel>
                                <StackPanel Style="{StaticResource SettingStackPanelStyle}">
                                    <local:SettingToggleSwitch
                                        x:Uid="Settings_Game_ReMapEnabled"
                                        IsOn="{x:Bind ViewModel.GameReMapEnabled, Mode=TwoWay}"/>
                                    <StackPanel Style="{StaticResource SettingStackPanelStyle}">
                                        <Button Command="{x:Bind ViewModel.OpenGlobalKeyMappingDialogCommand}" HorizontalAlignment="Stretch">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <SymbolIcon Symbol="Edit"/>
                                                <TextBlock x:Uid="Settings_Game_EditKeyMapping"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </control:Panel>
                            <!-- 自动探测游戏存档位置 -->
                            <control:Panel>
                                <local:SettingToggleSwitch
                                    x:Uid="Settings_Game_AutoDetectSavePath"
                                    IsOn="{x:Bind ViewModel.AutoDetectSavePath, Mode=TwoWay}"/>
                            </control:Panel>
                            <!-- 记录游玩次数的最小游玩时长 -->
                            <control:Panel>
                                <control:Setting x:Uid="SettingsPage_Game_MinPlayTimeRecordThreshold">
                                    <NumberBox Value="{x:Bind ViewModel.MinPlayTimeRecordThreshold, Mode=TwoWay}"
                                               SpinButtonPlacementMode="Compact"
                                               SmallChange="1" LargeChange="5" Minimum="0"
                                               Width="100"/>
                                </control:Setting>
                            </control:Panel>
                            <!-- 自定义打开文本文件类型 -->
                            <control:Panel>
                                <StackPanel>
                                    <TextBlock x:Uid="SettingsPage_Game_CustomTextFileExtensions_Title"/>
                                    <TextBlock x:Uid="SettingsPage_Game_CustomTextFileExtensions_Description"
                                               Style="{ThemeResource DescriptionTextStyle}"/>
                                    <TextBox x:Uid="SettingsPage_Game_CustomTextFileExtensions_EditBox"
                                             Text="{x:Bind ViewModel.CustomTextFileExtensionsString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="False" Margin="0,4,0,0" />
                                </StackPanel>
                            </control:Panel>
                        </StackPanel>
                    </control:SettingExpander.SettingContent>
                </control:SettingExpander>

                <!-- 游戏库 -->
                <control:SettingExpander
                    SettingTitle="{x:Bind ViewModel.UiLibraryTitle}"
                    SettingDescription="{x:Bind ViewModel.UiLibraryDescription}"
                    SettingIcon="&#xE8B7;">
                    <control:SettingExpander.SettingContent>
                        <StackPanel Style="{StaticResource SettingStackPanelStyle}">
                            <!-- 递归搜索子目录 -->
                            <control:Panel>
                                <StackPanel>
                                    <local:SettingToggleSwitch
                                        Title="{x:Bind ViewModel.UiLibrarySearchSubPath}"
                                        Description="{x:Bind ViewModel.UiLibrarySearchSubPathDescription}"
                                        IsOn="{x:Bind ViewModel.SearchSubFolder, Mode=TwoWay}"/>
                                </StackPanel>
                            </control:Panel>
                            <!-- 数据备份 -->
                            <control:Panel>
                                <StackPanel Spacing="{StaticResource SettingsPageStackPanelSpacing}">
                                    <StackPanel>
                                        <local:SettingToggleSwitch
                                            Title="{x:Bind ViewModel.UiLibraryMetaBackup}"
                                            Description="{x:Bind ViewModel.UiLibraryMetaBackupDescription}"
                                            IsOn="{x:Bind ViewModel.MetaBackup, Mode=TwoWay}" />
                                    </StackPanel>
                                    <control:Setting x:Uid="SettingsPage_Library_BackupNow">
                                        <Button Content="Go" Width="75" Command="{x:Bind ViewModel.SaveMetaBackUpCommand}">
                                            <Button.Flyout>
                                                <Flyout Placement="Bottom">
                                                    <TextBlock Text="{x:Bind ViewModel.MetaBackupProgress, Mode=OneWay}"/>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </control:Setting>
                                    <control:Setting x:Uid="SettingsPage_Library_RemoveAllBackup">
                                        <Button Content="Go" Width="75" Command="{x:Bind ViewModel.RemoveMetaBackUpCommand}">
                                            <Button.Flyout>
                                                <Flyout Placement="Bottom">
                                                    <TextBlock Text="{x:Bind ViewModel.RemoveMetaBackupProgress, Mode=OneWay}"/>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </control:Setting>
                                </StackPanel>
                            </control:Panel>

                            <!-- 游戏匹配规则 -->
                            <control:Panel>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{x:Bind ViewModel.UiLibraryGameSearchRule}"/>
                                    <TextBlock Text="{x:Bind ViewModel.UiLibraryGameSearchRuleDescription}"
                                               FontSize="12"
                                            Opacity="0.6"
                                            Margin="0 -8 0 0"/>
                                    <TextBox Header="{x:Bind ViewModel.UiLibraryGameSearchRuleMustContain}"
                                             Text="{x:Bind ViewModel.GameFolderMustContain,Mode=TwoWay}"
                                             TextWrapping="Wrap"
                                            AcceptsReturn="True"/>
                                    <TextBox Header="{x:Bind ViewModel.UiLibraryGameSearchRuleShouldContain}"
                                             Text="{x:Bind ViewModel.GameFolderShouldContain,Mode=TwoWay}"
                                             TextWrapping="Wrap"
                                            AcceptsReturn="True"/>
                                </StackPanel>
                            </control:Panel>

                            <!-- 正则表达式 -->
                            <control:Panel>
                                <StackPanel Spacing="{StaticResource SettingsPageStackPanelSpacing}">
                                    <TextBlock Text="{x:Bind ViewModel.UiLibraryNameDescription}" Margin="0 0 0 -3"
                                               Style="{ThemeResource DescriptionTextStyle}"/>
                                    <RelativePanel HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock Text="{x:Bind ViewModel.UiLibrarySearchRegex}"
                                                       Style="{ThemeResource BodyTextBlockStyle}" />
                                            <TextBlock Text="{x:Bind ViewModel.UiLibrarySearchRegexDescription}"
                                                       Style="{ThemeResource DescriptionTextStyle}"/>
                                        </StackPanel>
                                        <TextBox Text="{x:Bind ViewModel.Regex, Mode=TwoWay}"
                                                 RelativePanel.AlignRightWithPanel="True" />
                                    </RelativePanel>
                                    <RelativePanel HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock Text="{x:Bind ViewModel.UiLibrarySearchRegexIndex}"
                                                       Style="{ThemeResource BodyTextBlockStyle}" />
                                            <TextBlock Text="{x:Bind ViewModel.UiLibrarySearchRegexIndexDescription}"
                                                       Style="{ThemeResource DescriptionTextStyle}"/>
                                        </StackPanel>
                                        <TextBox Text="{x:Bind ViewModel.RegexIndex, Mode=TwoWay}"
                                                 RelativePanel.AlignRightWithPanel="True" />
                                    </RelativePanel>
                                    <local:SettingToggleSwitch
                                        Title="{x:Bind ViewModel.UiLibrarySearchRegexRemoveBorder}"
                                        Description="{x:Bind ViewModel.UiLibrarySearchRegexRemoveBorderDescription}"
                                        IsOn="{x:Bind ViewModel.RegexRemoveBorder, Mode=TwoWay}" />
                                    <RelativePanel HorizontalAlignment="Stretch">
                                        <TextBox Text="{x:Bind ViewModel.RegexTryItOut, Mode=TwoWay}"
                                                 PlaceholderText="{x:Bind ViewModel.UiLibrarySearchRegexTryItOut}" />
                                        <Button Content="Go" Command="{x:Bind ViewModel.RegexTryItOutCommand}"
                                                RelativePanel.AlignRightWithPanel="True" />
                                    </RelativePanel>
                                </StackPanel>
                            </control:Panel>
                        </StackPanel>
                    </control:SettingExpander.SettingContent>
                </control:SettingExpander>

                <!-- 云同步 -->
                <control:SettingExpander
                    SettingTitle="{x:Bind ViewModel.UiCloudSyncTitle}"
                    SettingDescription="{x:Bind ViewModel.UiCloudSyncDescription}"
                    SettingIcon="&#xE753;">
                    <control:SettingExpander.SettingContent>
                        <StackPanel Style="{StaticResource SettingStackPanelStyle}">
                            <!-- 云同步根目录 -->
                            <control:Panel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.UiCloudSyncRoot}" Margin="0 0 25 0"
                                               VerticalAlignment="Center" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{x:Bind ViewModel.RemoteFolder, Mode=OneWay}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        Margin="0 0 25 0" />
                                    <Button Grid.Column="2" x:Uid="Select" MinWidth="75"
                                            Command="{x:Bind ViewModel.SelectRemoteFolderCommand}" />
                                </Grid>
                            </control:Panel>
                        </StackPanel>
                    </control:SettingExpander.SettingContent>
                </control:SettingExpander>

                <!-- 启动 -->
                <control:SettingExpander
                    x:Uid="SettingsPage_Start"
                    SettingIcon="&#xE768;">
                    <control:SettingExpander.SettingContent>
                        <StackPanel Style="{StaticResource SettingStackPanelStyle}">
                            <!-- 开机自启 -->
                            <control:Panel Visibility="{x:Bind ViewModel.IsMSIXPackaged}">
                                <StackPanel Spacing="{StaticResource SettingsPageStackPanelSpacing}">
                                    <!-- 是否开机自启 -->
                                    <local:SettingToggleSwitch
                                        x:Uid="SettingsPage_Start_AutoStartOnLogin"
                                        IsOn="{x:Bind ViewModel.AutoStartWhenLogin, Mode=TwoWay}"/>
                                    <!-- 开机自启时是否最小化到托盘 -->
                                    <local:SettingToggleSwitch
                                        x:Uid="SettingsPage_Start_MinToTray"
                                        IsOn="{x:Bind ViewModel.MinToTrayWhenAutoStart, Mode=TwoWay}"
                                        Visibility="{x:Bind ViewModel.AutoStartWhenLogin, Mode=OneWay}"/>
                                </StackPanel>
                            </control:Panel>
                            <!-- 初始启动页面 -->
                            <control:Panel>
                                <control:Setting x:Uid="SettingsPage_Start_Page">
                                    <ComboBox MinWidth="{StaticResource ToggleSwitchWidth}"
                                              ItemsSource="{x:Bind ViewModel.StartPages}"
                                              SelectedItem="{x:Bind ViewModel.StartPage, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="enums:PageEnum">
                                                <TextBlock Text="{x:Bind Converter={StaticResource EnumToStringConverter}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </control:Setting>
                            </control:Panel>
                            <!-- 身份验证方式 -->
                            <control:Panel>
                                <control:Setting x:Uid="SettingsPage_Start_AuthenticationType">
                                    <ComboBox MinWidth="{StaticResource ToggleSwitchWidth}"
                                              ItemsSource="{x:Bind ViewModel.AuthenticationTypes}"
                                              SelectedItem="{x:Bind ViewModel.AuthenticationType, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="enums:AuthenticationType">
                                                <TextBlock Text="{x:Bind Converter={StaticResource AuthenticationTypeToStringConverter}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </control:Setting>
                            </control:Panel>
                            <!-- 启动游戏 -->
                            <control:Panel>
                                <local:SettingToggleSwitch
                                    x:Uid="SettingsPage_Start_AutoStartGame"
                                    IsOn="{x:Bind ViewModel.QuitStart, Mode=TwoWay}" />
                            </control:Panel>
                            <!-- 创建桌面快捷方式 -->
                            <control:Panel>
                                <control:Setting  x:Uid="SettingsPage_Start_DesktopShortcut">
                                    <Button Content="Go"
                                            MinWidth="{StaticResource ButtonMinWidth}"
                                            Command="{x:Bind ViewModel.CreateDesktopShortcutCommand}"/>
                                </control:Setting>
                            </control:Panel>
                        </StackPanel>
                    </control:SettingExpander.SettingContent>
                </control:SettingExpander>

                <!-- 消息通知 -->
                <control:SettingExpander x:Uid="SettingsPage_Notification" SettingIcon="&#xEA8F;">
                    <control:SettingExpander.SettingContent>
                        <StackPanel Style="{StaticResource SettingStackPanelStyle}">
                            <!-- 完成游戏扫描通知 -->
                            <control:Panel>
                                <StackPanel Style="{StaticResource SettingStackPanelStyle}">
                                    <local:SettingToggleSwitch x:Uid="SettingsPage_Notification_GetGalgameFolder"
                                                               IsOn="{x:Bind ViewModel.NotifyWhenGetGalgameInFolder, Mode=TwoWay}"/>
                                    <local:SettingToggleSwitch x:Uid="SettingsPage_Notification_GetGalgameFolder_Empty"
                                                               IsOn="{x:Bind ViewModel.EventWhenGetGalgameInFolderEmpty, Mode=TwoWay}"/>
                                </StackPanel>
                            </control:Panel>
                            <!-- 完成游戏解压通知 -->
                            <control:Panel>
                                <local:SettingToggleSwitch x:Uid="SettingsPage_Notification_Unpack"
                                                           IsOn="{x:Bind ViewModel.NotifyWhenUnpackGame, Mode=TwoWay}"/>
                            </control:Panel>
                            <!-- Pvn同步事件通知 -->
                            <control:Panel>
                                <StackPanel Style="{StaticResource SettingStackPanelStyle}">
                                    <local:SettingToggleSwitch x:Uid="SettingsPage_Notification_Pvn"
                                                               IsOn="{x:Bind ViewModel.EventPvnSync, Mode=TwoWay}"/>
                                    <local:SettingToggleSwitch x:Uid="SettingsPage_Notification_Pvn_Empty"
                                                               Margin="{ThemeResource SmallTopMargin}"
                                                               Visibility="{x:Bind ViewModel.EventPvnSync, Mode=OneWay}"
                                                               IsOn="{x:Bind ViewModel.EventPvnSyncEmpty, Mode=TwoWay}"/>
                                </StackPanel>
                            </control:Panel>
                        </StackPanel>
                    </control:SettingExpander.SettingContent>
                </control:SettingExpander>

                <!-- 其他设置 -->
                <control:SettingExpander x:Uid="SettingsPage_Other" SettingIcon="&#xE713;">
                    <control:SettingExpander.SettingContent>
                        <StackPanel Style="{StaticResource SettingStackPanelStyle}">
                            <!-- 关闭模式 -->
                            <control:Panel>
                                <control:Setting x:Uid="SettingsPage_Other_CloseMode">
                                    <ComboBox MinWidth="{StaticResource ToggleSwitchWidth}"
                                              ItemsSource="{x:Bind ViewModel.WindowModes}"
                                              SelectedItem="{x:Bind ViewModel.CloseMode, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="enums:WindowMode">
                                                <TextBlock Text="{x:Bind Converter={StaticResource WindowModeToStringConverter}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </control:Setting>
                            </control:Panel>
                            <!-- 导出数据 -->
                            <control:Panel>
                                <control:Setting x:Uid="SettingsPage_Other_Export">
                                    <Button x:Uid="SettingsPage_Other_Export_Button"
                                            MinWidth="{StaticResource ButtonMinWidth}"
                                            Command="{x:Bind ViewModel.ExportDataCommand}"/>
                                </control:Setting>
                            </control:Panel>
                            <!-- 自动导出数据 -->
                            <control:Panel>
                                <StackPanel Style="{StaticResource SettingStackPanelStyle}">
                                    <local:SettingToggleSwitch x:Uid="SettingsPage_Other_AutoExport"
                                                               IsOn="{x:Bind ViewModel.IsAutoExportEnabled, Mode=TwoWay}"/>
                                    <!-- 导出时间间隔 -->
                                    <control:Setting x:Uid="SettingsPage_Other_AutoExport_Interval"
                                                     Description="{x:Bind ViewModel.AutoExportIntervalDescription, Mode=OneWay}"
                                                     Visibility="{x:Bind ViewModel.IsAutoExportEnabled, Mode=OneWay}">
                                        <NumberBox Value="{x:Bind ViewModel.AutoExportInterval, Mode=TwoWay}"
                                                   SpinButtonPlacementMode="Compact"
                                                   SmallChange="1" LargeChange="24" Minimum="1"
                                                   Width="100"/>
                                    </control:Setting>
                                    <!-- 导出路径 -->
                                    <control:Setting x:Uid="SettingsPage_Other_AutoExport_Path"
                                                     Description="{x:Bind ViewModel.AutoExportPathDescription, Mode=OneWay}">
                                        <Button x:Uid="SettingsPage_Other_AutoExport_Path_Button"
                                                MinWidth="{StaticResource ButtonMinWidth}"
                                                Command="{x:Bind ViewModel.SelectAutoExportPathCommand}"/>
                                    </control:Setting>
                                    <!-- 最多保存备份数 -->
                                    <control:Setting x:Uid="SettingsPage_Other_AutoExport_MaxBackupNumber"
                                                     Visibility="{x:Bind ViewModel.IsAutoExportEnabled, Mode=OneWay}">
                                        <NumberBox Value="{x:Bind ViewModel.MaxBackupNumber, Mode=TwoWay}"
                                                   SpinButtonPlacementMode="Compact"
                                                   SmallChange="1" LargeChange="10" Minimum="1"
                                                   Width="100"/>
                                    </control:Setting>
                                </StackPanel>
                            </control:Panel>
                            <!-- 导入数据 -->
                            <control:Panel>
                                <control:Setting x:Uid="SettingsPage_Other_Import">
                                    <Button x:Uid="SettingsPage_Other_Import_Button"
                                            MinWidth="{StaticResource ButtonMinWidth}"
                                            Command="{x:Bind ViewModel.ImportDataCommand}"/>
                                </control:Setting>
                            </control:Panel>
                            <!-- 优化内存占用 -->
                            <control:Panel>
                                <local:SettingToggleSwitch x:Uid="SettingsPage_Other_Memory"
                                                           IsOn="{x:Bind ViewModel.MemoryImprove, Mode=TwoWay}"/>
                            </control:Panel>
                            <!-- 上传匿名事件日志 -->
                            <control:Panel>
                                <local:SettingToggleSwitch x:Uid="SettingsPage_Other_AppCenter"
                                                           IsOn="{x:Bind ViewModel.UploadToAppCenter, Mode=TwoWay}"/>
                            </control:Panel>
                            <!-- 指纹共享计划 -->
                            <control:Panel>
                                <local:SettingToggleSwitch x:Uid="SettingsPage_Other_FingerprintPlan"
                                                           IsOn="{x:Bind ViewModel.FingerprintPlanEnabled, Mode=TwoWay}"/>
                            </control:Panel>
                            <!-- 开发者模式 -->
                            <control:Panel>
                                <RelativePanel HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Vertical">
                                        <HyperlinkButton x:Uid="SettingsPage_Other_DevelopmentMode" Padding="0"/>
                                        <TextBlock x:Uid="SettingsPage_Other_DevelopmentMode_Description"
                                                   FontSize="12" Opacity="0.6" />
                                    </StackPanel>
                                    <ToggleSwitch IsOn="{x:Bind ViewModel.DevelopmentMode, Mode=TwoWay}"
                                                  Margin="0,0,-80,0"
                                                  RelativePanel.AlignRightWithPanel="True" />
                                </RelativePanel>
                            </control:Panel>
                            <!-- 更新通道 -->
                            <control:Panel Visibility="{x:Bind ViewModel.IsSideloadVersion, Mode=OneWay}">
                                <local:SettingToggleSwitch x:Uid="SettingsPage_Other_BetaChannel"
                                                           IsOn="{x:Bind ViewModel.IsBetaChannel, Mode=TwoWay}"/>
                            </control:Panel>
                        </StackPanel>
                    </control:SettingExpander.SettingContent>
                </control:SettingExpander>

                <!-- 关于 -->
                <TextBlock x:Uid="Settings_About" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <StackPanel Margin="{StaticResource XSmallTopMargin}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- PotatoVN-版本 -->
                        <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.VersionDescription, Mode=OneWay}"
                                   Style="{ThemeResource BodyTextBlockStyle}" VerticalAlignment="Center"/>
                        <!-- 更新提醒 -->
                        <Grid Grid.Column="1" Background="{ThemeResource  ControlAltFillColorSecondaryBrush}"
                              CornerRadius="10" VerticalAlignment="Center" Margin="10 0 0 0"
                              Visibility="{x:Bind ViewModel.UpdateAvailable, Mode=OneWay}">
                            <HyperlinkButton x:Uid="SettingsPage_About_UpdateAvailable" Padding="10 0 10 0"
                                Command="{x:Bind ViewModel.OpenUpdateWebCommand}"/>
                    </Grid>
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                        <HyperlinkButton x:Uid="SettingsPage_PrivacyTermsLink"
                                         Margin="{StaticResource SettingsPageHyperlinkButtonMargin}" />
                        <HyperlinkButton x:Uid="SettingsPage_RepositoryLink" />
                        <HyperlinkButton x:Uid="SettingsPage_UpdateContent" Command="{x:Bind ViewModel.UpdateContentCommand}"/>
                        <HyperlinkButton x:Uid="SettingsPage_RateLink" Command="{x:Bind ViewModel.RateCommand}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <InfoBar Grid.Row="1" IsOpen="{x:Bind ViewModel.IsInfoBarOpen, Mode=OneWay}"
                 Severity="{x:Bind ViewModel.InfoBarSeverity, Mode=OneWay}"
                 Message="{x:Bind ViewModel.InfoBarMsg, Mode=OneWay}"/>
    </Grid>
</Page>
