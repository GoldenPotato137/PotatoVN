<Page
    x:Class="GalgameManager.Views.ScanResultPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:GalgameManager.Models"
    xmlns:converter="using:GalgameManager.Helpers.Converter"
    xmlns:cmtkConverters="using:CommunityToolkit.WinUI.Converters"
    mc:Ignorable="d"
    x:Name="Page">
    
    <Page.Resources>
        <converter:ScanResultToGlyph x:Key="ResultToGlyph"/>
        <converter:ScanResultToBrush x:Key="ResultToBrush"/>
        <converter:ScanResultToString x:Key="ResultToString"/>
        <converter:AnyToVisibilityConverter x:Key="ToVisibility"/>
        <cmtkConverters:StringVisibilityConverter x:Key="StringToVisibility" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,0,0,12">
            <TextBlock x:Uid="ScanResultPage_SourceName" FontWeight="SemiBold" Margin="0,0,5,0"/>
            <TextBlock Text="{x:Bind ViewModel.SourceName, Mode=OneWay}" />
            <TextBlock x:Uid="ScanResultPage_ScanTime" FontWeight="SemiBold" Margin="20,0,5,0"/>
            <TextBlock Text="{x:Bind ViewModel.ScanTime, Mode=OneWay}" />
            <TextBlock x:Uid="ScanResultPage_SourcePath" FontWeight="SemiBold" Margin="20,0,5,0"/>
            <TextBlock Text="{x:Bind ViewModel.SourcePath, Mode=OneWay}" />
        </StackPanel>

        <AutoSuggestBox x:Uid="ScanResultPage_Search" Grid.Row="1" Margin="12,0,12,12"
                        QueryIcon="Find"
                        Text="{x:Bind ViewModel.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        
        <ScrollViewer Grid.Row="2" Margin="12,0,12,12">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.DisplayResults, Mode=OneWay}">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:Key="ScanResultItemTemplate" x:DataType="models:PathScanResultItem">
                        <Border Margin="0 0 10 8"
                                CornerRadius="5"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Padding="15 10 50 10"
                                Background="{x:Bind ResultType, Converter={StaticResource ResultToBrush}}">
                            <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Path}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind Message}" TextWrapping="WrapWholeWords"
                                               Visibility="{x:Bind Message, Converter={StaticResource StringToVisibility}}"/>
                                    <HyperlinkButton x:Uid="ScanResultPage_SeeRelatedGame" 
                                                     Command="{Binding ElementName=Page, Path=ViewModel.CheckGameCommand}"
                                                     CommandParameter="{x:Bind}"
                                                     Padding="0"
                                                     Visibility="{x:Bind RelatedGameId, Converter={StaticResource ToVisibility}}"/>
                                </StackPanel>
                                <Grid Grid.Column="1"/>
                                <TextBlock Grid.Column="2" Text="{x:Bind ResultType, Converter={StaticResource ResultToString}}"
                                           VerticalAlignment="Center"/>
                                <FontIcon Grid.Column="3" FontFamily="Segoe Fluent Icons" Margin="{StaticResource SmallLeftMargin}"
                                          Glyph="{x:Bind ResultType, Converter={StaticResource ResultToGlyph}}"
                                          FontSize="30"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</Page>
