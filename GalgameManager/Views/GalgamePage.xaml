<Page
    x:Class="GalgameManager.Views.HomeDetailPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:GalgameManager.Helpers.Converter"
    xmlns:local="using:GalgameManager.Helpers"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:control="using:GalgameManager.Views.Control"
    xmlns:galgamePagePanel="using:GalgameManager.Views.GalgamePagePanel"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:core="using:Microsoft.Xaml.Interactions.Core"
    xmlns:behaviors="using:GalgameManager.Behaviors"
    xmlns:sources="using:GalgameManager.Models.Sources"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:ImagePathConverter x:Key="ImagePathConverter" />
        <converters:AnyToVisibilityConverter x:Key="AnyToVisConv"/>
        <converters:SourceToGlyphConverter x:Key="SourceToGlyphConverter"/>
    </Page.Resources>

    <Grid>
        <Grid RowDefinitions="Auto,*">
            <CommandBar Grid.Row="0" Background="Transparent" IsOpen="False" DefaultLabelPosition="Right"
                        Margin="{StaticResource CommandBarMargin}">
                <!-- 开始游戏 -->
                <AppBarElementContainer
                    Visibility="{x:Bind ViewModel.IsLocalGame,
                    Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                    <SplitButton x:Name="PlaySplitButton" Command="{x:Bind ViewModel.PlayCommand}">
                        <interactivity:Interaction.Behaviors>
                            <core:EventTriggerBehavior EventName="RightTapped">
                                <core:InvokeCommandAction Command="{x:Bind ViewModel.ResetExePathCommand}" />
                            </core:EventTriggerBehavior>
                        </interactivity:Interaction.Behaviors>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE768;" />
                            <TextBlock x:Uid="MultiInstall_PlayButton"/>
                        </StackPanel>
                        <SplitButton.Flyout>
                            <Flyout Placement="Bottom">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <Setter Property="Padding" Value="6" />
                                        <Setter Property="CornerRadius" Value="12" />
                                        <Setter Property="MinWidth" Value="360" />
                                        <Setter Property="MaxWidth" Value="480" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <StackPanel Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="10,6,10,8">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7FC;" FontSize="16"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock x:Uid="MultiInstall_Select_Title"
                                                   Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <ScrollViewer MaxHeight="320" HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Installations, Mode=OneWay}">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Spacing="6" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="sources:GalgameAndPath">
                                                    <Button Style="{ThemeResource TransparentButtonWithHover}"
                                                            DataContext="{x:Bind}"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch"
                                                            Padding="10,8"
                                                            Click="SelectInstallation_OnClick">
                                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="8"
                                                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                                    VerticalAlignment="Center">
                                                                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="16"
                                                                          Glyph="{x:Bind Source, Mode=OneWay,
                                                                          Converter={StaticResource SourceToGlyphConverter}}" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                                <TextBlock Text="{x:Bind Source.Name, FallbackValue={x:Null}}"
                                                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{x:Bind Path}" TextTrimming="CharacterEllipsis"
                                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </StackPanel>
                                                            <FontIcon Grid.Column="2" FontFamily="Segoe Fluent Icons"
                                                                      Glyph="&#xE73E;" FontSize="16" VerticalAlignment="Center"
                                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                                      Visibility="{x:Bind IsPreferred, Mode=OneWay,
                                                                      Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </ScrollViewer>
                                    <Rectangle Height="1" Margin="8,4"
                                               Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <Button Style="{ThemeResource TransparentButtonWithHover}"
                                            Command="{x:Bind ViewModel.SettingCommand}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                        <StackPanel Orientation="Horizontal" Spacing="12"
                                                    Padding="0,5">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" FontSize="16"
                                                      Width="38" HorizontalAlignment="Center" />
                                            <TextBlock x:Uid="MultiInstall_Manage" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Flyout>
                        </SplitButton.Flyout>
                    </SplitButton>
                </AppBarElementContainer>
                <!-- 设置本地路径 -->
                <AppBarButton x:Uid="GalgamePage_SetLocalPath" Command="{x:Bind ViewModel.SetLocalPathCommand}"
                              Visibility="{x:Bind ViewModel.IsLocalGame,
                              Converter={StaticResource BoolToVisibilityConverter},
                              ConverterParameter = True, Mode=OneWay}">
                    <AppBarButton.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE723;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <!-- 编辑 -->
                <AppBarButton Icon="Edit" x:Uid="GalgamePage_Edit" Command="{x:Bind ViewModel.SettingCommand}" />
                <!-- 游玩状态 -->
                <AppBarButton x:Uid="GalgamePage_PlayStatus" Command="{x:Bind ViewModel.ChangePlayStatusCommand}">
                    <AppBarButton.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74C;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <!-- 打开文本 -->
                <AppBarButton x:Uid="GalgamePage_OpenText" Command="{x:Bind ViewModel.SelectTextCommand}"
                              Icon="{ui:FontIcon Glyph=&#xE8A1;}">
                    <AppBarButton.ContextFlyout>
                        <Flyout Placement="Bottom" x:Name="ClearTextFlyout">
                            <StackPanel>
                                <TextBlock Style="{ThemeResource BaseTextBlockStyle}"
                                           x:Uid="GalgamePage_TextFlyout_ClearText" />
                                <Button Command="{x:Bind ViewModel.ClearTextCommand}"
                                        local:FlyoutHelper.CloseFlyoutOnClick="True"
                                        x:Uid="YesButton"
                                        Margin="{StaticResource SmallTopMargin}" HorizontalAlignment="Center"
                                        Flyout="{x:Bind ClearTextFlyout}"/>
                            </StackPanel>
                        </Flyout>
                    </AppBarButton.ContextFlyout>
                </AppBarButton>
                <!-- 在文件资源管理器中打开 -->
                <AppBarButton Icon="OpenLocal"
                        x:Uid="GalgamePage_OpenInExplorer"
                        IsEnabled="{x:Bind ViewModel.IsLocalGame, Mode=OneWay}"
                        Command="{x:Bind ViewModel.OpenInExplorerCommand}"
                        Visibility="{x:Bind ViewModel.ShowSingleExplorerButton, Mode=OneWay}"/>
                <AppBarButton x:Name="OpenInstallationFlyoutButton" Icon="OpenLocal"
                        x:Uid="GalgamePage_Open"
                        IsEnabled="{x:Bind ViewModel.IsLocalGame, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ShowExplorerMenu, Mode=OneWay}">
                    <AppBarButton.Flyout>
                        <Flyout Placement="Bottom">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="Padding" Value="6" />
                                    <Setter Property="CornerRadius" Value="12" />
                                    <Setter Property="MinWidth" Value="360" />
                                    <Setter Property="MaxWidth" Value="480" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <StackPanel Spacing="2">
                                <ScrollViewer MaxHeight="320" HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Installations, Mode=OneWay}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Spacing="6" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="sources:GalgameAndPath">
                                                <Button Style="{ThemeResource TransparentButtonWithHover}"
                                                        DataContext="{x:Bind}"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Stretch"
                                                        Padding="10,8"
                                                        Click="OpenInstallation_OnClick">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="8"
                                                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                                VerticalAlignment="Center">
                                                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="16"
                                                                      Glyph="{x:Bind Source, Mode=OneWay,
                                                                      Converter={StaticResource SourceToGlyphConverter}}" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                            <TextBlock Text="{x:Bind Source.Name, FallbackValue={x:Null}}"
                                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{x:Bind Path}" TextTrimming="CharacterEllipsis"
                                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </ScrollViewer>
                                <Rectangle Height="1" Margin="8,4"
                                           Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                                           Visibility="{x:Bind ViewModel.HasSaveDirectory,
                                           Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                                <Button Style="{ThemeResource TransparentButtonWithHover}"
                                        Command="{x:Bind ViewModel.OpenSaveDirectoryCommand}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Padding="10,8"
                                        Visibility="{x:Bind ViewModel.HasSaveDirectory,
                                        Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74E;" FontSize="16"
                                                  Width="38" HorizontalAlignment="Center" />
                                        <TextBlock x:Uid="MultiInstall_OpenSaveDirectoryButton" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Flyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <CommandBar.SecondaryCommands>
                    <!-- 转区运行游戏 -->
                    <AppBarToggleButton Icon="Character"
                            x:Uid="GalgamePage_RunInLocaleEmulator"
                                        Command="{x:Bind ViewModel.ChangeRunInLocaleEmulatorCommand}"
                                        IsChecked="{x:Bind ViewModel.CurrentInstallationConfig.RunInLocaleEmulator, Mode=TwoWay, FallbackValue=False}"
                                        IsEnabled="{x:Bind ViewModel.IsLocalGame, Mode=OneWay}"/>
                    <!-- 以管理员权限运行游戏 -->
                    <AppBarToggleButton Icon="Admin"
                                        x:Uid="GalgamePage_RunAsAdmin"
                                        Command="{x:Bind ViewModel.SaveCommand}"
                                        IsChecked="{x:Bind ViewModel.CurrentInstallationConfig.RunAsAdmin, Mode=TwoWay, FallbackValue=False}"
                                        IsEnabled="{x:Bind ViewModel.IsLocalGame, Mode=OneWay}"/>
                    <!-- 高DPI替代缩放 -->
                    <AppBarToggleButton x:Uid="GalgamePage_HighDpi"
                                        Command="{x:Bind ViewModel.ChangeHighDpiCommand}"
                                        IsChecked="{x:Bind ViewModel.CurrentInstallationConfig.HighDpi, Mode=TwoWay, FallbackValue=False}"
                                        IsEnabled="{x:Bind ViewModel.IsLocalGame, Mode=OneWay}">
                        <AppBarToggleButton.Icon>
                            <control:ConditionalFontIcon Symbol="GoToStart"
                                    FluentGlyph="&#xE7F4;"/>
                        </AppBarToggleButton.Icon>
                    </AppBarToggleButton>
                    <!-- Magpie -->
                    <AppBarToggleButton Icon="FullScreen"
                                        x:Uid="GalgamePage_EnableMagpie"
                                        Command="{x:Bind ViewModel.SaveCommand}"
                                        IsChecked="{x:Bind ViewModel.Item.EnableMagpie, Mode=TwoWay, FallbackValue=False}"
                                        IsEnabled="{x:Bind ViewModel.IsLocalGame, Mode=OneWay}"/>
                    <!-- 后台静音 -->
                    <AppBarToggleButton x:Uid="GamePage_MuteInBackground"
                                        IsChecked="{x:Bind ViewModel.Item.MuteInBackground, Mode=TwoWay, FallbackValue=False}"
                                        IsEnabled="{x:Bind ViewModel.IsLocalGame, Mode=OneWay}">
                        <AppBarToggleButton.Icon>
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEA8F;" /> <!-- Mute icon -->
                        </AppBarToggleButton.Icon>
                    </AppBarToggleButton>
                    <!-- 快捷键映射 -->
                    <AppBarToggleButton x:Uid="GamePage_KeyReMap"
                                        Command="{x:Bind ViewModel.SaveCommand}"
                                        IsChecked="{x:Bind ViewModel.Item.KeyReMap, Mode=TwoWay, FallbackValue=False}"
                                        IsEnabled="{x:Bind ViewModel.IsLocalGame, Mode=OneWay}">
                        <AppBarToggleButton.Icon>
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE765;" /> <!-- KeyBoard icon -->
                        </AppBarToggleButton.Icon>
                    </AppBarToggleButton>
                    <AppBarSeparator/>
                    <!-- 在外部网站中打开 -->
                    <AppBarButton x:Uid="GalgamePage_OpenInExternalWebsite"
                                  Visibility="{x:Bind ViewModel.CanOpenInExternalWebsite, Mode=OneWay}">
                        <AppBarButton.Icon>
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8AD;" />
                        </AppBarButton.Icon>
                        <AppBarButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Uid="GalgamePage_OpenInBgmMenu"
                                                Icon="{ui:FontIcon Glyph=&#xE8AD;}"
                                                Command="{x:Bind ViewModel.OpenInBgmCommand}"
                                                Visibility="{x:Bind ViewModel.CanOpenInBgm, Mode=OneWay}" />
                                <MenuFlyoutItem x:Uid="GalgamePage_OpenInVndbMenu"
                                                Icon="{ui:FontIcon Glyph=&#xE8AD;}"
                                                Command="{x:Bind ViewModel.OpenInVndbCommand}"
                                                Visibility="{x:Bind ViewModel.CanOpenInVndb, Mode=OneWay}" />
                                <MenuFlyoutItem x:Uid="GalgamePage_OpenInYmgalMenu"
                                                Icon="{ui:FontIcon Glyph=&#xE8AD;}"
                                                Command="{x:Bind ViewModel.OpenInYmgalCommand}"
                                                Visibility="{x:Bind ViewModel.CanOpenInYmgal, Mode=OneWay}" />
                                <MenuFlyoutItem x:Uid="GalgamePage_OpenInCngalMenu"
                                                Icon="{ui:FontIcon Glyph=&#xE8AD;}"
                                                Command="{x:Bind ViewModel.OpenInCngalCommand}"
                                                Visibility="{x:Bind ViewModel.CanOpenInCngal, Mode=OneWay}" />
                                <MenuFlyoutItem x:Uid="GalgamePage_OpenInHikarinagiMenu"
                                                Icon="{ui:FontIcon Glyph=&#xE8AD;}"
                                                Command="{x:Bind ViewModel.OpenInHikarinagiCommand}"
                                                Visibility="{x:Bind ViewModel.CanOpenInHikarinagi, Mode=OneWay}" />
                                <MenuFlyoutItem x:Uid="GalgamePage_OpenInSteamMenu"
                                                Icon="{ui:FontIcon Glyph=&#xE8AD;}"
                                                Command="{x:Bind ViewModel.OpenInSteamCommand}"
                                                Visibility="{x:Bind ViewModel.CanOpenInSteam, Mode=OneWay}" />
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>
                    <!-- 下载游玩状态 -->
                    <AppBarButton x:Uid="GalgamePage_SyncFromBgm"
                            Command="{x:Bind ViewModel.SyncFromBgmCommand}"
                                  Visibility="{x:Bind ViewModel.CanOpenInBgm,
                                  Mode=OneWay}">
                        <AppBarButton.Icon>
                            <FontIcon FontFamily="Segoe Fluent Icons"
                                    Glyph="&#xE74C;"/>
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton x:Uid="GalgamePage_SyncFromVndb"
                            Command="{x:Bind ViewModel.SyncFromVndbCommand}"
                                  Visibility="{x:Bind ViewModel.CanOpenInVndb,
                                  Mode=OneWay}">
                        <AppBarButton.Icon>
                            <FontIcon FontFamily="Segoe Fluent Icons"
                                    Glyph="&#xE74C;"/>
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarSeparator/>
                    <!-- 手动选择进程 -->
                    <AppBarButton
                        x:Uid="GalgamePage_SelectThread"
                        Command="{x:Bind ViewModel.SelectProcessCommand}"
                        Visibility="{x:Bind ViewModel.IsSelectProcessVisible, Mode=OneWay}">
                        <AppBarButton.Icon>
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE840;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <!-- 移除进程指定 -->
                    <AppBarButton
                        x:Uid="GalgamePage_RemoveSelectedThread"
                        Command="{x:Bind ViewModel.RemoveSelectedThreadCommand}"
                        Visibility="{x:Bind ViewModel.IsRemoveSelectedThreadVisible, Mode=OneWay}">
                        <AppBarButton.Icon>
                            <FontIcon FontFamily="Segoe Fluent Icons"
                                    Glyph="&#xE738;"/>
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <!-- 重置exe和文本路径 -->
                    <AppBarButton
                        x:Uid="GalgamePage_ResetPath"
                        Command="{x:Bind ViewModel.ResetPathCommand}"
                        Visibility="{x:Bind ViewModel.IsResetPathVisible, Mode=OneWay}">
                        <AppBarButton.Icon>
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74E;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarSeparator/>
                    <!-- 设置界面显示的元素 -->
                    <AppBarButton x:Uid="GalgamePage_ManageLayout"
                            Command="{x:Bind ViewModel.ManageLayoutCommand}"
                            IsEnabled="{x:Bind ViewModel.SettingAvailable, Mode=OneWay}">
                        <AppBarButton.Icon>
                            <FontIcon FontFamily="Segoe Fluent Icons"
                                    Glyph="&#xE713;"/>
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarSeparator/>
                    <!-- 改变存档位置 -->
                    <AppBarButton
                        x:Uid="GalgamePage_ChangeSavePosition"
                        Command="{x:Bind ViewModel.ChangeSavePositionCommand}"
                        IsEnabled="{x:Bind ViewModel.IsLocalGame, Mode=OneWay}">
                        <AppBarButton.Icon>
                            <FontIcon FontFamily="Segoe Fluent Icons"
                                    Glyph="&#xE74E;"/>
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <!-- 移入另一个源 -->
                    <AppBarButton x:Uid="GalgamePage_MoveToAnotherSource"
                                  Command="{x:Bind ViewModel.MoveToSourceCommand}"
                                  IsEnabled="{x:Bind ViewModel.IsLocalGame, Mode=OneWay}">
                        <AppBarButton.Icon>
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8DE;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <!-- 彻底删除游戏 -->
                    <AppBarButton Icon="Delete" x:Uid="GalgamePage_Delete" Command="{x:Bind ViewModel.DeleteFromDiskCommand}"
                                  IsEnabled="{x:Bind ViewModel.IsLocalGame, Mode=OneWay}"/>
                    <AppBarButton Icon="Remove" x:Uid="MultiInstall_DeleteGame"
                                  Command="{x:Bind ViewModel.DeletePermanentlyCommand}"/>
                </CommandBar.SecondaryCommands>
            </CommandBar>

            <ContentPresenter Grid.Row="1" Content="{x:Bind ViewModel.PluginUi, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.Plugin, Converter={StaticResource AnyToVisConv}}"/>
            <!-- Layout New -->
            <Grid Grid.Row="1" Visibility="{x:Bind ViewModel.PluginUi, Mode=OneWay,
                    Converter={StaticResource AnyToVisConv}, ConverterParameter=false}">
                <ScrollViewer IsTabStop="True" Margin="-55 0 -55 0" CornerRadius="8">
                    <Grid RowDefinitions="*,*">
                        <Image Grid.Row="0"
                               Visibility="{x:Bind ViewModel.ShowBackgroundImage, Mode=OneWay}"
                               VerticalAlignment="Top"
                               Stretch="Uniform" HorizontalAlignment="Stretch"
                               Source="{x:Bind ViewModel.Item.HeaderImagePath, Mode=OneWay,
                                         FallbackValue={x:Null}, Converter={StaticResource ImagePathConverter},
                                         ConverterParameter='null_ignoreDefaultPotato'}"/>

                        <StackPanel Grid.Row="0" Grid.RowSpan="2">
                            <galgamePagePanel:GameHeaderPanel Game="{x:Bind ViewModel.Item, Mode=OneWay}" />
                            <Grid ColumnDefinitions="2*,1,1*">
                                <StackPanel Grid.Column="0" Spacing="10" Margin="0 0 30 0">
                                    <galgamePagePanel:GameDescriptionPanel
                                        Game="{x:Bind ViewModel.Item, Mode=OneWay}" />
                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.LeftPanelPluginUis}">
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="UIElement">
                                                <ContentPresenter Content="{x:Bind}" />
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>
                                <Rectangle Grid.Column="1" Width="1" Margin="0 20"
                                           Fill="{ThemeResource SystemControlForegroundBaseLowBrush}"
                                           VerticalAlignment="Stretch" />
                                <StackPanel Grid.Column="2" Spacing="10" Margin="30 0 30 0">
                                    <galgamePagePanel:GamePlayStatusPanel
                                        Game="{x:Bind ViewModel.Item, Mode=OneWay}" />
                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.RightPanelPluginUis}">
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="UIElement">
                                                <ContentPresenter Content="{x:Bind}" />
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>
                            </Grid>
                            <galgamePagePanel:GameTagPanel Game="{x:Bind ViewModel.Item, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.ShowTagPanel, Mode=OneWay}"/>
                            <galgamePagePanel:GameCharacterPanel
                                Game="{x:Bind ViewModel.Item, Mode=OneWay}"
                                AddCharacterCommand="{x:Bind ViewModel.AddCharacterCommand}"
                                DeleteCharacterCommand="{x:Bind ViewModel.DeleteCharacterCommand}"
                                Visibility="{x:Bind ViewModel.ShowCharacterPanel, Mode=OneWay}"/>
                            <interactivity:Interaction.Behaviors>
                                <behaviors:ResponsivePaddingBehavior OrinWidth="1000" OrinPadding="100 0 100 0"/>
                            </interactivity:Interaction.Behaviors>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <Grid
                Background="#00000000"
                Visibility="{x:Bind ViewModel.IsPhrasing, Mode=OneWay}">
                <ProgressRing
                    IsActive="True"
                    Width="100"
                    Height="100"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Grid>
</Page>
