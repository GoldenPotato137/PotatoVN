<Page
    x:Class="GalgameManager.Views.GalgameSettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:control="using:GalgameManager.Views.Control"
    xmlns:converter="using:GalgameManager.Helpers.Converter"
    xmlns:cmtkControls="using:CommunityToolkit.WinUI.Controls"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:core="using:Microsoft.Xaml.Interactions.Core"
    mc:Ignorable="d">

    <Page.Resources>
        <converter:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <Style x:Key="SettingStackPanelStyle" TargetType="StackPanel">
            <Setter Property="Spacing" Value="13" />
            <Setter Property="Orientation" Value="Vertical" />
        </Style>
    </Page.Resources>

    <Grid RowDefinitions="Auto,*">
        <CommandBar Grid.Row="0" Background="Transparent" IsOpen="False" DefaultLabelPosition="Right"
                    Margin="{StaticResource CommandBarMargin}">
            <AppBarButton x:Uid="Back" Command="{x:Bind ViewModel.BackCommand}">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72B;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Uid="GalgameSettingPage_GetInfoFromRss" 
                Command="{x:Bind ViewModel.GetInfoFromRssCommand}"
                AllowFocusOnInteraction="True">
                <AppBarButton.Icon>
                    <control:ConditionalFontIcon Symbol="Download" FluentGlyph="&#xE896;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Uid="GalgameSettingPage_GetInfoFromRssWithName"
                          Command="{x:Bind ViewModel.GetInfoFromRssCommand}"
                          CommandParameter="True"
                          AllowFocusOnInteraction="True">
                <AppBarButton.Icon>
                    <control:ConditionalFontIcon Symbol="Download" FluentGlyph="&#xE896;" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0 0 0 40">
            <StackPanel Margin="{StaticResource MediumRightMargin}">
                <!-- 游戏配置 -->
                <control:SettingExpander x:Uid="GalgameSettingPage_GameSetting"
                                         SettingIcon="&#xE7FC;" SettingSymbol="ViewAll">
                    <control:SettingExpander.SettingContent>
                        <StackPanel Style="{StaticResource SettingStackPanelStyle}">
                            <!-- 游戏路径 -->
                            <control:Panel>
                                <control:Setting x:Uid="GalgameSettingPage_GameSetting_Path"
                                                 Description="{x:Bind ViewModel.LocalPathMsg, Mode=OneWay}">
                                    <HyperlinkButton Command="{x:Bind ViewModel.SetGalgamePathCommand}"
                                                     VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <SymbolIcon Symbol="Edit" />
                                            <TextBlock x:Uid="GalgameSettingPage_EditPath" />
                                        </StackPanel>
                                    </HyperlinkButton>
                                </control:Setting>
                            </control:Panel>
                            <!-- 游戏启动文件 -->
                            <control:Panel Visibility="{x:Bind ViewModel.IsLocalGame, Mode=OneWay}">
                                <control:Setting x:Uid="GalgameSettingPage_GameSetting_ExePath"
                                                 Description="{x:Bind ViewModel.ExePathMsg, Mode=OneWay}">
                                    <HyperlinkButton Command="{x:Bind ViewModel.SetGalgameExePathCommand}"
                                                     VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <SymbolIcon Symbol="Edit" />
                                            <TextBlock x:Uid="GalgameSettingPage_EditExePath" />
                                        </StackPanel>
                                    </HyperlinkButton>
                                </control:Setting>
                            </control:Panel>
                            <!-- 游戏启动参数 -->
                            <control:Panel Visibility="{x:Bind ViewModel.IsLocalGame, Mode=OneWay}">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <TextBlock x:Uid="GalgameSettingPage_GameSetting_Parameter"
                                               Margin="0 0 15 0" VerticalAlignment="Center" />
                                    <Grid Grid.Column="1" />
                                    <TextBox x:Uid="GalgameSettingPage_GameSetting_Parameter_Input" Grid.Column="2"
                                             Text="{x:Bind ViewModel.Gal.ExeArguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalAlignment="Center" TextAlignment="Center"
                                             MinWidth="200"
                                             ToolTipService.ToolTip="就把他当成cmd来用就行了" />
                                </Grid>
                            </control:Panel>
                            <!-- 存档位置（尚未做完，隐藏） -->
                            <control:Panel Visibility="Collapsed">
                                <control:Setting x:Uid="GalgameSettingPage_GameSetting_SavePosition"
                                                 Description="{x:Bind ViewModel.Gal.SavePosition}">
                                    <Button IsEnabled="False"/>
                                </control:Setting>
                            </control:Panel>
                        </StackPanel>
                    </control:SettingExpander.SettingContent>
                </control:SettingExpander>

                <!-- 游戏信息 -->
                <control:SettingExpander x:Uid="GalgameSettingPage_GameInfo"
                                         SettingDescription="{x:Bind ViewModel.GalgameInfoDescription, Mode=OneWay}"
                                         SettingIcon="&#xE713;" SettingSymbol="Setting"
                                         IsExpanded="True">
                    <control:SettingExpander.SettingContent>
                        <StackPanel Style="{StaticResource SettingStackPanelStyle}">
                            <!-- 游戏名 -->
                            <control:Panel>
                                <control:LockableTextBox
                                    x:Uid="GalgameSettingPage_GalgameName"
                                    Value="{x:Bind ViewModel.Gal.Name.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    IsLock="{x:Bind ViewModel.Gal.Name.IsLock, Mode=TwoWay}"
                                    AcceptsReturn="False" />
                            </control:Panel>
                            <!-- 游戏ID -->
                            <control:Panel>
                                <Grid ColumnDefinitions="Auto,5*,Auto,2*,Auto" ColumnSpacing="20">
                                    <TextBlock Grid.Column="0" x:Uid="GalgameSettingPage_GalgameId" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" x:Uid="GalgameSettingPage_GameInfo_GalgameId_Input"
                                             Text="{x:Bind ViewModel.Gal.Id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" x:Uid="GalgameSettingPage_GalgameRssType" 
                                               VerticalAlignment="Center" Margin="20 0 0 0"/>
                                    <control:ComboBoxWithoutNull 
                                        Grid.Column="3" VerticalAlignment="Center" 
                                        ItemsSource="{x:Bind ViewModel.RssTypes}"
                                        SelectedItem="{x:Bind ViewModel.SelectedRss, Mode=TwoWay}"/>
                                    <HyperlinkButton Grid.Column="4" VerticalAlignment="Center"
                                                     NavigateUri="{x:Bind ViewModel.SearchUri, Mode=OneWay}"
                                                     Margin="20 0 0 0">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <SymbolIcon Symbol="Find" />
                                            <TextBlock x:Uid="GalgameSettingPage_Search" />
                                        </StackPanel>
                                    </HyperlinkButton>
                                </Grid>
                            </control:Panel>
                            <!-- 发布日期 -->
                            <control:Panel>
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                    <TextBlock Grid.Column="0" x:Uid="GalgameSettingPage_GameInfo_ReleaseDate"
                                               VerticalAlignment="Center" Margin="{StaticResource MediumRightMargin}"/>
                                    <CalendarDatePicker Grid.Column="1" 
                                                        IsEnabled="{x:Bind ViewModel.Gal.ReleaseDate.IsLock, 
                                                                Mode=TwoWay, Converter={StaticResource InverseBooleanConverter}}"
                                                        Date="{x:Bind ViewModel.ReleasedDate, Mode=TwoWay}"
                                                        Margin="{StaticResource MediumRightMargin}"/>
                                    <Grid Grid.Column="2"/>
                                    <ToggleSwitch Grid.Column="3" x:Uid="GalgameSettingPage_ToggleSwitch" 
                                                  IsOn="{x:Bind ViewModel.Gal.ReleaseDate.IsLock, Mode=TwoWay}"
                                                  Margin="0 0 -50 0"/>
                                </Grid>
                            </control:Panel>
                            <!-- 评分 -->
                            <control:Panel>
                                <control:LockableNumberBox
                                    x:Uid="GalgameSettingPage_GalgameRating"
                                    Value="{x:Bind ViewModel.Gal.Rating.Value, Mode=TwoWay}"
                                    IsLock="{x:Bind ViewModel.Gal.Rating.IsLock, Mode=TwoWay}"/>
                            </control:Panel>
                            <!-- 开发商 -->
                            <control:Panel>
                                <control:LockableTextBox
                                    x:Uid="GalgameSettingPage_GalgameDeveloper"
                                    Value="{x:Bind ViewModel.Gal.Developer.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    IsLock="{x:Bind ViewModel.Gal.Developer.IsLock, Mode=TwoWay}" />
                            </control:Panel>
                            <!-- 预计游玩时长 -->
                            <control:Panel>
                                <control:LockableTextBox
                                    x:Uid="GalgameSettingPage_GalgameExpectedPlayTime"
                                    Value="{x:Bind ViewModel.Gal.ExpectedPlayTime.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    IsLock="{x:Bind ViewModel.Gal.ExpectedPlayTime.IsLock, Mode=TwoWay}" />
                            </control:Panel>
                            <!-- 游戏简介 -->
                            <control:Panel>
                                <control:LockableTextBox
                                    x:Uid="GalgameSettingPage_GalgameDescription"
                                    Value="{x:Bind ViewModel.Gal.Description.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    IsLock="{x:Bind ViewModel.Gal.Description.IsLock, Mode=TwoWay}"
                                    AcceptsReturn="True" />
                            </control:Panel>
                            <!-- 封面图 -->
                            <control:Panel>
                                <control:Setting x:Uid="GalgameSettingPage_GalgameImagePath"
                                                 Description="{x:Bind ViewModel.Gal.ImagePath.Value, Mode=OneWay}">
                                    <Button x:Uid="GalgameSettingPage_PickImage"
                                            Command="{x:Bind ViewModel.PickImageCommand}"
                                            Margin="0 10 0 0"/>
                                </control:Setting>
                            </control:Panel>
                            <!-- Tags -->
                            <control:Panel>
                                <interactivity:Interaction.Behaviors>
                                    <core:EventTriggerBehavior EventName="SizeChanged">
                                        <core:InvokeCommandAction Command="{x:Bind ViewModel.PageSizeChangedCommand}"/>
                                    </core:EventTriggerBehavior>
                                </interactivity:Interaction.Behaviors>
                                <Expander IsExpanded="False" HorizontalContentAlignment="Stretch"
                                          Width="{x:Bind ViewModel.TagWidth, Mode=OneWay}">
                                    <Expander.Header>
                                        <Grid RowDefinitions="Auto,Auto">
                                            <TextBlock Grid.Row="0" x:Uid="GalgameSettingPage_TagsTitle"/>
                                            <TextBlock Grid.Row="1" x:Uid="GalgameSettingPage_GameInfo_Tag_Description" 
                                                       Style="{StaticResource DescriptionTextStyle}"/>
                                        </Grid>
                                    </Expander.Header>
                                    <StackPanel Orientation="Vertical">
                                        <StackPanel Orientation="Vertical">
                                            <ToggleSwitch IsOn="{x:Bind ViewModel.Gal.Tags.IsLock, Mode=TwoWay}"
                                                          x:Uid="GalgameSettingPage_ToggleSwitch"/>
                                        </StackPanel>
                                        <cmtkControls:TokenizingTextBox
                                            IsEnabled="{x:Bind ViewModel.Gal.Tags.IsLock, 
                                            Converter={StaticResource InverseBooleanConverter}, Mode=OneWay}"
                                            ItemsSource="{x:Bind ViewModel.Gal.Tags.Value, Mode=TwoWay}"
                                            PlaceholderText="Add Tags"
                                            x:Name="TagsBox">
                                            <cmtkControls:TokenizingTextBox.SuggestedItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding }" />
                                                </DataTemplate>
                                            </cmtkControls:TokenizingTextBox.SuggestedItemTemplate>
                                            <cmtkControls:TokenizingTextBox.TokenItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding }" />
                                                </DataTemplate>
                                            </cmtkControls:TokenizingTextBox.TokenItemTemplate>
                                        </cmtkControls:TokenizingTextBox>
                                    </StackPanel>
                                </Expander>
                            </control:Panel>
                        </StackPanel>
                    </control:SettingExpander.SettingContent>
                </control:SettingExpander>
            </StackPanel>
        </ScrollViewer>

        <Grid
            Grid.Row="1"
            Background="#00000000"
            Visibility="{x:Bind ViewModel.IsPhrasing, Mode=OneWay}">
            <ProgressRing
                IsActive="True"
                Width="100"
                Height="100"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Page>